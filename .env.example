# Contact form → itsuzairnaseer@gmail.com (SMTP on Vercel)
CONTACT_TO=itsuzairnaseer@gmail.com

# Gmail SMTP — use an App Password (not your normal Gmail password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itsuzairnaseer@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=itsuzairnaseer@gmail.com

# Careers portal session signing (set a long random string in production)
SESSION_SECRET=change-me-in-production

# Recruiter portal login
RECRUITER_EMAIL=Query@dialerbot.online
RECRUITER_NAME=Contactivity Talent
RECRUITER_PASSWORD=set-a-strong-password
# One-shot password reset: set true, restart once, then set false / remove.
RECRUITER_RESET_PASSWORD=false

# --- Free cloud portal storage (Vercel) ---
# 1) Create a free Turso DB: https://app.turso.tech
# 2) Copy URL + token into Vercel env vars
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# 3) In Vercel → Storage → Create Blob store (Hobby free)
#    BLOB_READ_WRITE_TOKEN is usually auto-injected; or paste it here for local testing
BLOB_READ_WRITE_TOKEN=

# Local-only fallback (when TURSO_* unset): SQLite file under ./data
# PORTAL_DATA_DIR=
