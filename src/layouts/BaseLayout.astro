---
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  absoluteUrl,
  organizationJsonLd,
  websiteJsonLd,
} from '../data/seo';
import '../styles/reveal.css';
import '../styles/mast.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Smooth Lenis scroll — off on portal for snappier TTI */
  smoothScroll?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
  smoothScroll = true,
  jsonLd,
} = Astro.props;

const pageTitle = title.includes('Dialer Bot') ? title : `${title} | Dialer Bot`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absoluteUrl(image);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';

const baseSchemas = noindex ? [] : [organizationJsonLd(), websiteJsonLd()];
const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [...baseSchemas, ...extraSchemas];

const fontHref =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content="Dialer Bot" />
    <meta name="theme-color" content="#1e322d" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dialer Bot" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dialer Bot — AI voice bots for calling floors" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Dialer Bot — AI voice bots for calling floors" />
    <meta name="twitter:domain" content="dialerbot.online" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM context" href="/llms.txt" />
    <link rel="alternate" hrefLang="en" href={canonical} />
    <link rel="dns-prefetch" href="//wa.me" />
    <link rel="dns-prefetch" href="//demo.dialerbot.online" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font CSS (swap in after load) -->
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>
    <title>{pageTitle}</title>
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <WhatsAppFloat />

    <script define:vars={{ smoothScroll }}>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealNodes = document.querySelectorAll('[data-reveal]');
      if (revealNodes.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealNodes.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            },
            { threshold: 0.14, rootMargin: '0px 0px -6% 0px' },
          );
          revealNodes.forEach((el) => io.observe(el));
        }
      }

      // Defer Lenis until after first paint so LCP/TTI stay snappy
      if (smoothScroll && !reduced) {
        const startLenis = () => {
          import('lenis').then(({ default: Lenis }) => {
            import('lenis/dist/lenis.css');
            const lenis = new Lenis({
              duration: 1.65,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
              orientation: 'vertical',
              gestureOrientation: 'vertical',
              smoothWheel: true,
              wheelMultiplier: 0.72,
              touchMultiplier: 1.35,
              infinite: false,
              autoRaf: false,
            });

            window.__lenis = lenis;

            const raf = (time) => {
              lenis.raf(time);
              requestAnimationFrame(raf);
            };
            requestAnimationFrame(raf);
            document.documentElement.classList.add('has-smooth-scroll');

            document.addEventListener('click', (e) => {
              const a = e.target?.closest?.('a[href]');
              if (!a) return;
              const href = a.getAttribute('href');
              if (!href || href === '#' || /^https?:/i.test(href)) return;
              let url;
              try {
                url = new URL(href, window.location.href);
              } catch {
                return;
              }
              if (url.origin !== window.location.origin) return;
              if (url.pathname !== window.location.pathname) return;
              if (!url.hash || url.hash === '#') return;
              const el = document.querySelector(url.hash);
              if (!el) return;
              e.preventDefault();
              lenis.scrollTo(el, { offset: -72, duration: 1.75 });
              history.pushState(null, '', url.hash);
            });

            const syncMenuLock = () => {
              if (document.body.style.overflow === 'hidden') lenis.stop();
              else lenis.start();
            };
            new MutationObserver(syncMenuLock).observe(document.body, {
              attributes: true,
              attributeFilter: ['style'],
            });
          });
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(startLenis, { timeout: 1800 });
        } else {
          setTimeout(startLenis, 400);
        }
      }
    </script>
  </body>
</html>
