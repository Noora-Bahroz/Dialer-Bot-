---
import DemoSticky from '../components/DemoSticky.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  absoluteUrl,
  organizationJsonLd,
  websiteJsonLd,
  siteNavigationJsonLd,
} from '../data/seo';
import '../styles/reveal.css';
import '../styles/mobile-layout.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Smooth Lenis scroll — off on portal for snappier TTI */
  smoothScroll?: boolean;
  /** Sticky mobile demo bar — off on portal / noindex pages */
  showDemoBar?: boolean;
  /** Preload LCP / above-fold images (absolute site paths) */
  preloadImages?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
  smoothScroll = true,
  showDemoBar,
  preloadImages = [],
  jsonLd,
} = Astro.props;

const demoBar = showDemoBar ?? !noindex;

const pageTitle = title.includes('Dialer Bot') ? title : `${title} | Dialer Bot`;
// Match sitemap + trailingSlash:never (homepage without trailing slash)
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';

const baseSchemas = noindex ? [] : [organizationJsonLd(), websiteJsonLd(), siteNavigationJsonLd()];
const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [...baseSchemas, ...extraSchemas];

const fontHref =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="author" content="Dialer Bot" />
    <meta name="theme-color" content="#1e322d" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dialer Bot" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dialer Bot — AI voice bots for calling floors" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Dialer Bot — AI voice bots for calling floors" />
    <meta name="twitter:domain" content="dialerbot.online" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Dialer Bot" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM context" href="/llms.txt" />
    <link rel="alternate" hrefLang="en" href={canonical} />
    <link rel="alternate" hrefLang="x-default" href={canonical} />
    {
      preloadImages.map((src) =>
        src.endsWith('.webp') ? (
          <link rel="preload" as="image" href={src} type="image/webp" fetchpriority="high" />
        ) : (
          <link rel="preload" as="image" href={src} fetchpriority="high" />
        ),
      )
    }
    <link rel="dns-prefetch" href="//wa.me" />
    <link rel="dns-prefetch" href="//demo.dialerbot.online" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font CSS (swap in after load) -->
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>
    <title>{pageTitle}</title>
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    {demoBar && <DemoSticky />}
    <WhatsAppFloat />

    <script define:vars={{ smoothScroll }}>
      document.documentElement.dataset.smoothScroll = smoothScroll ? '1' : '0';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealNodes = document.querySelectorAll('[data-reveal]');
      if (revealNodes.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealNodes.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            },
            { threshold: 0.14, rootMargin: '0px 0px -6% 0px' },
          );
          revealNodes.forEach((el) => io.observe(el));
        }
      }
    </script>
    <script>
      // Bundled module so Vite resolves Lenis JS + CSS (dynamic CSS import 404'd in prod).
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const smoothScroll = document.documentElement.dataset.smoothScroll === '1';
      // Skip Lenis on phones — continuous RAF costs TBT for little UX gain.
      const coarse =
        window.matchMedia('(max-width: 900px)').matches ||
        window.matchMedia('(pointer: coarse)').matches;

      if (smoothScroll && !reduced && !coarse) {
        const startLenis = () => {
          const lenis = new Lenis({
            duration: 1.65,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 0.72,
            touchMultiplier: 1.35,
            infinite: false,
            autoRaf: false,
          });

          window.__lenis = lenis;

          const raf = (time) => {
            lenis.raf(time);
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);
          document.documentElement.classList.add('has-smooth-scroll');

          document.addEventListener('click', (e) => {
            const a = e.target?.closest?.('a[href]');
            if (!a) return;
            const href = a.getAttribute('href');
            if (!href || href === '#' || /^https?:/i.test(href)) return;
            let url;
            try {
              url = new URL(href, window.location.href);
            } catch {
              return;
            }
            if (url.origin !== window.location.origin) return;
            if (url.pathname !== window.location.pathname) return;
            if (!url.hash || url.hash === '#') return;
            const el = document.querySelector(url.hash);
            if (!el) return;
            e.preventDefault();
            lenis.scrollTo(el, { offset: -72, duration: 1.75 });
            history.pushState(null, '', url.hash);
          });

          const syncMenuLock = () => {
            if (document.body.style.overflow === 'hidden') lenis.stop();
            else lenis.start();
          };
          new MutationObserver(syncMenuLock).observe(document.body, {
            attributes: true,
            attributeFilter: ['style'],
          });
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(startLenis, { timeout: 1800 });
        } else {
          setTimeout(startLenis, 400);
        }
      }
    </script>
  </body>
</html>
