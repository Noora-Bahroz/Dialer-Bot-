---
interface Props {
  term: string;
  definition: string;
  /** Use on dark heroes / masts so text stays readable */
  tone?: 'light' | 'dark';
}
const { term, definition, tone = 'light' } = Astro.props;
---

<section class:list={['aeo-def', `aeo-def--${tone}`]} aria-label={`${term} definition`}>
  <p class="aeo-def__label">Definition</p>
  <p class="aeo-def__term">{term}</p>
  <p class="aeo-def__text">{definition}</p>
</section>

<style>
  .aeo-def {
    margin: 1.25rem 0 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid #2f9d63;
    border-radius: 0 10px 10px 0;
    background: rgba(47, 157, 99, 0.06);
  }
  .aeo-def__label {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2f9d63;
  }
  .aeo-def__term {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 800;
    color: #1e322d;
  }
  .aeo-def__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #3d4a45;
  }

  .aeo-def--dark {
    border-left-color: #dbfe7a;
    background: rgba(219, 254, 122, 0.08);
  }
  .aeo-def--dark .aeo-def__label {
    color: #dbfe7a;
  }
  .aeo-def--dark .aeo-def__term {
    color: #f3f7f4;
  }
  .aeo-def--dark .aeo-def__text {
    color: rgba(243, 247, 244, 0.78);
  }
</style>
