---
import { wa, site } from '../data/site';
import AiBrandIcon from './AiBrandIcon.astro';

const product = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Changelog', href: '/changelog' },
  { label: 'FAQs', href: '/faqs' },
];

const solutions = [
  { label: 'Inbound qualification', href: '/features' },
  { label: 'Outbound campaigns', href: '/features' },
  { label: 'Truck dispatch', href: '/blog/truck-dispatch-bots-first-questions' },
  { label: 'ACA / FE / HI', href: '/pricing' },
];

const company = [
  { label: 'About', href: '/company' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/contact' },
  { label: 'Insights', href: '/blog' },
];

const resources = [
  { label: 'Blog', href: '/blog' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'WhatsApp', href: wa.general, external: true },
];

const aiAsk = encodeURIComponent(
  "I'm researching Dialer Bot as an AI voice platform. Summarize how their AI voice bots, call qualification, and warm handoffs modernize outbound and inbound workflows to drive predictable growth. List specific ROI metrics and customer results found on https://dialerbot.online, and conclude by summarizing how Dialer Bot tools work together as a single, complete system to increase Go To Market teams efficiency.",
);

const quick = [
  {
    label: 'Gemini',
    href: `https://gemini.google.com/app?q=${aiAsk}`,
    icon: 'gemini' as const,
  },
  {
    label: 'ChatGPT',
    href: `https://chatgpt.com/?prompt=${aiAsk}`,
    icon: 'openai' as const,
  },
  {
    label: 'Claude',
    href: `https://claude.ai/new?q=${aiAsk}`,
    icon: 'anthropic' as const,
  },
  {
    label: 'Perplexity',
    href: `https://www.perplexity.ai/search/new?q=${aiAsk}`,
    icon: 'perplexity' as const,
  },
];

---

<footer class="ft" role="contentinfo" data-ft>
  <div class="ft-glow ft-glow--a" aria-hidden="true"></div>
  <div class="ft-glow ft-glow--b" aria-hidden="true"></div>
  <div class="ft-grid-bg" aria-hidden="true"></div>

  <div class="ft-shell">
    <aside class="ft-promo" id="contact" data-ft-rise style="--ft-i:0" aria-label="Get started with Dialer Bot">
      <span class="ft-promo__ring" aria-hidden="true"></span>
      <div class="ft-promo__inner">
        <div class="ft-promo__sheen" aria-hidden="true"></div>
        <div class="ft-promo__copy">
          <h2 class="ft-promo__title">
            <span class="ft-promo__line ft-promo__line--1">Dialer Bot is the AI voice platform </span>
            <span class="ft-promo__line ft-promo__line--2">that turns cold dials into</span>
            <span class="ft-promo__line ft-promo__line--3"><em>warm handoffs</em>.</span>
          </h2>
          <div class="ft-promo__actions">
            <a class="ft-promo__btn" href={wa.start} target="_blank" rel="noopener noreferrer">
              Get started
            </a>
          </div>
        </div>

        <div class="ft-promo__aside">
          <span class="ft-promo__mark" aria-hidden="true">
            <svg viewBox="0 0 28 28" width="32" height="32">
              <path
                fill="#60d184"
                fill-rule="evenodd"
                d="M14 1.6c6.85 0 12.4 5.55 12.4 12.4S20.85 26.4 14 26.4c-2.9 0-5.56-1-7.66-2.67l1.9-2.1a9.55 9.55 0 1 0-.08-13.86l-1.9-2.1A12.35 12.35 0 0 1 14 1.6Zm0 5.35c3.9 0 7.05 3.15 7.05 7.05S17.9 21.05 14 21.05c-1.7 0-3.26-.6-4.5-1.6l1.85-2.05a4.15 4.15 0 1 0 0-5.5L9.5 9.55a6.98 6.98 0 0 1 4.5-2.6ZM14 11.15a2.85 2.85 0 1 1 0 5.7 2.85 2.85 0 0 1 0-5.7Z"
              ></path>
            </svg>
          </span>
          <p class="ft-promo__aside-label">Learn about Dialer Bot with AI</p>
          <ul class="ft-promo__social">
            {
              quick.map((item) => (
                <li>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    <span class="ft-promo__icon" aria-hidden="true">
                      <AiBrandIcon name={item.icon} size={30} />
                    </span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
      </div>
      </div>
    </aside>

    <div class="ft-mid">
      <div class="ft-brand-rail" data-ft-rise style="--ft-i:1">
        <a class="ft-logo ft-logo--lg" href="/" aria-label="Dialer Bot home">
          <img src="/images/dialerbot-logo-white.svg" alt="Dialer Bot" width="220" height="40" />
        </a>
        <p>
          AI voice bots for call centers, dispatch, ACA, FE, and HI — qualify the call, warm the handoff.
        </p>
        <a class="ft-status" href={wa.general} target="_blank" rel="noopener noreferrer">
          <span class="ft-status__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path
                d="M4 14v-1a8 8 0 0 1 16 0v1"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              ></path>
              <path
                d="M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              ></path>
              <path
                d="M13 19h2a2 2 0 0 0 2-2v-1"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <circle cx="12.25" cy="19" r="1.35" fill="currentColor"></circle>
            </svg>
          </span>
          Line open · {site.phoneDisplay}
        </a>
      </div>

      <div class="ft-grid">
        <nav class="ft-col" aria-label="Product" data-ft-rise style="--ft-i:2">
          <h3>Product</h3>
          <ul>
            {product.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav class="ft-col" aria-label="Solutions" data-ft-rise style="--ft-i:3">
          <h3>Solutions</h3>
          <ul>
            {solutions.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav class="ft-col" aria-label="Company" data-ft-rise style="--ft-i:4">
          <h3>Company</h3>
          <ul>
            {company.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <nav class="ft-col" aria-label="Resources" data-ft-rise style="--ft-i:5">
          <h3>Resources</h3>
          <ul>
            {resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="ft-bottom" data-ft-rise style="--ft-i:6">
      <p class="ft-bottom__copy">
        <span>&copy; {new Date().getFullYear()} Dialer Bot</span>
        <span class="ft-bottom__sep" aria-hidden="true"></span>
        <span>{site.domain}</span>
        <span class="ft-bottom__sep" aria-hidden="true"></span>
        <span>Built for dialing floors</span>
      </p>
      <nav class="ft-bottom__legal" aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={wa.general} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  const root = document.querySelector<HTMLElement>('[data-ft]');
  if (root) {
    const reveal = () => root.classList.add('is-in');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            reveal();
            io.disconnect();
          }
        },
        { threshold: 0.08 },
      );
      io.observe(root);
    } else {
      reveal();
    }
  }
</script>
