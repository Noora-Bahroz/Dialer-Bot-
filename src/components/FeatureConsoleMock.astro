        </div>
        <div class="ent-toolbar-actions">
          <span class="ent-status live">Healthy</span>
          <button type="button" class="ent-btn quiet" data-mock>Test line</button>
        </div>
      </div>

      <section class="studio-cast">
        <div class="studio-cast-h">
          <span>Humanized voices</span>
          <button type="button" class="ent-link" data-mock>Browse library</button>
        </div>
        <div class="studio-voices">
          {voices.map((v) => (
            <button type="button" class:list={['studio-voice', { 'is-on': v.on }]} data-mock>
              <span class="studio-avatar" aria-hidden="true">{v.name.slice(0, 1)}</span>
              <span class="studio-voice-main">
                <strong>{v.name}</strong>
                <em>{v.meta}</em>
              </span>
              <span class="studio-voice-state">{v.on ? 'Active' : 'Ready'}</span>
            </button>
