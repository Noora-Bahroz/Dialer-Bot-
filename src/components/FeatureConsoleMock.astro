        </div>
      </section>

      <div class="studio-grid">
        <section class="studio-pane">
          <header class="studio-pane-h">
            <h4>Model</h4>
            <span>Streaming</span>
          </header>
          <div class="studio-fields">
            <button type="button" class="studio-field is-on" data-mock>
              <span>Runtime</span>
              <strong>Streaming LLM</strong>
            </button>
            <button type="button" class="studio-field" data-mock>
              <span>Understanding</span>
              <strong>Intent + entities</strong>
            </button>
            <button type="button" class="studio-field" data-mock>
              <span>Barge-in</span>
              <strong>Natural cutover</strong>
            </button>
          </div>
        </section>

        <section class="studio-pane">
          <header class="studio-pane-h">
            <h4>Script control</h4>
            <span>Policy</span>
          </header>
          <div class="studio-toggles">
            <button type="button" class="studio-toggle is-on" data-mock>
              <span class="studio-switch" aria-hidden="true"><i /></span>
              Hardcoded openers
            </button>
            <button type="button" class="studio-toggle is-on" data-mock>
              <span class="studio-switch" aria-hidden="true"><i /></span>
              Fine-tuned follow-ups
            </button>
            <button type="button" class="studio-toggle" data-mock>
              <span class="studio-switch" aria-hidden="true"><i /></span>
              Branch overrides
            </button>
          </div>
        </section>
      </div>

      <section class="studio-monitor">
        <div class="studio-monitor-h">
          <span>Backend · recording · QA</span>
          <em>call_9182</em>
        </div>
        <div class="studio-log">
          <button type="button" class="is-on" data-mock><time>14:02:19</time><strong>Intent classified</strong><em>subsidy_yes</em></button>
          <button type="button" data-mock><time>14:02:41</time><strong>QA monitor</strong><em>pass</em></button>
        </div>
      </section>

      <div class="studio-footer">
        <div>
          <strong>Custom control plane</strong>
          <em>Swap voices, tune scripts, keep audit history in one place</em>
        </div>
        <button type="button" class="ent-btn solid" data-mock>See how it works</button>
      </div>
    </div>
  )
}

{
  variant === 'motive' && (
    <div class="ent ent-motive" data-viz aria-label="Floor efficiency panel">
      <div class="ent-toolbar">
        <div>
          <p class="ent-kicker">Floor impact</p>
          <h3>First five minutes</h3>
        </div>
        <div class="ent-toolbar-actions">
          <span class="ent-status live">Improving</span>
          <button type="button" class="ent-btn quiet" data-mock>Last 7 days</button>
        </div>
      </div>

      <div class="ent-kpi-row motive-kpis">
        <button type="button" class="ent-kpi" data-mock>
          <span>Intake time</span>
          <strong>−60%</strong>
          <em>vs manual openers</em>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Seats on openers</span>
          <strong>12 → 5</strong>
          <em>7 seats freed</em>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Warm handoff</span>
          <strong data-ent-count data-to="41" data-fmt="pct">41%</strong>
          <em>of dialed volume</em>
        </button>
      </div>

      <div class="motive-compare">
        <button type="button" class="motive-card" data-mock>
          <span class="motive-card-label">Before</span>
          <strong>12 agents</strong>
          <em>Burned on first contact</em>
          <ul>
            <li>Raw dials hit live seats</li>
            <li>Tire-kickers consume time</li>
            <li>Hold & hangups pile up</li>
          </ul>
        </button>
        <button type="button" class="motive-card is-on" data-mock>
          <span class="motive-card-label">With Dialer Bot</span>
          <strong>5 agents</strong>
          <em>Focused on closers only</em>
          <ul>
            <li>Bot owns questions 1–5</li>
            <li>Warm leads only transfer</li>
            <li>Same floor throughput</li>
          </ul>
        </button>
      </div>

      <div class="ent-panel motive-split">
        <div class="ent-panel-h">
          <span>Ownership split</span>
          <span>Talk time share</span>
        </div>
        <div class="motive-stack" data-mock role="presentation">
          <i class="bot" style="width:72%" />
          <i class="agent" style="width:28%" />
        </div>
        <div class="motive-legend">
          <button type="button" data-mock>
            <span class="swatch bot" />
            Bot clears
            <strong>72%</strong>
          </button>
          <button type="button" data-mock>
            <span class="swatch agent" />
            Agent closes
            <strong>28%</strong>
          </button>
        </div>
      </div>

      <div class="motive-footer">
        <div>
          <strong>Seat math that sticks</strong>
          <em>Hardcoded openers first · qualify · then hand off</em>
        </div>
        <button type="button" class="ent-btn solid" data-mock>See breakdown</button>
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll('[data-viz]').forEach((root) => {
    if (!root.classList.contains('ent')) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile =
      window.matchMedia('(max-width: 900px)').matches ||
      window.matchMedia('(pointer: coarse)').matches;
    let inView = false;
    let counted = false;
    let loopId = 0;

    const formatCount = (n, fmt) => {
      const v = Math.round(n);
      if (fmt === 'pct') return `${v}%`;
      if (fmt === 'comma') return v.toLocaleString('en-US');
      return String(v);
    };

    const runCountUp = () => {
      if (counted || reduced) return;
      counted = true;
      root.querySelectorAll('[data-ent-count]').forEach((el) => {
        const to = Number(el.getAttribute('data-to') || '0');
        const fmt = el.getAttribute('data-fmt') || 'int';
        const start = performance.now();
        const dur = 1100;
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = formatCount(to * eased, fmt);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = formatCount(to, fmt);
        };
        requestAnimationFrame(tick);
      });
    };

    const rotateHighlight = () => {
      if (!inView || reduced) return;
      const cards = Array.from(root.querySelectorAll('.rx-card'));
      if (cards.length) {
        const on = cards.findIndex((c) => c.classList.contains('is-on'));
        const next = (on + 1) % cards.length;
        cards.forEach((c) => c.classList.remove('is-on'));
        cards[next].classList.add('is-on');
      }

      const rows = Array.from(root.querySelectorAll('.ent-table tbody tr'));
      if (rows.length) {
        const on = rows.findIndex((r) => r.classList.contains('is-on'));
        const next = (on + 1) % rows.length;
        rows.forEach((r) => r.classList.remove('is-on'));
        rows[next].classList.add('is-on');
      }

      const seats = Array.from(root.querySelectorAll('.sync-seat.bot, .sync-seat.agent'));
      if (seats.length) {
        seats.forEach((s) => s.classList.remove('is-on'));
        seats[Math.floor(Math.random() * seats.length)].classList.add('is-on');
      }
    };

    const startLoop = () => {
      if (loopId || reduced || mobile) return;
      loopId = window.setInterval(rotateHighlight, 3200);
    };

    const stopLoop = () => {
      if (!loopId) return;
      window.clearInterval(loopId);
      loopId = 0;
    };

    root.querySelectorAll('[data-mock]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        el.classList.add('is-pressed');
        window.setTimeout(() => el.classList.remove('is-pressed'), 140);

        const scopes =
          '.ent-queue, .ent-list, .ent-flow, .ent-table tbody, .motive-compare, .rx-col, .sync-floor, .sync-side-stats, .sync-pipe, .sync-counts, .studio-voices, .studio-fields, .studio-toggles, .studio-log';
        const scope = el.closest(scopes);
        if (!scope) return;

        let target = null;
        if (scope.tagName === 'TBODY') {
          target = el.closest('tr');
        } else if (el.classList.contains('studio-toggle')) {
          el.classList.toggle('is-on');
          return;
        } else if (
          el.classList.contains('rx-card') ||
          el.classList.contains('sync-seat') ||
          el.classList.contains('sync-node') ||
          el.classList.contains('studio-voice') ||
          el.classList.contains('studio-field') ||
          el.classList.contains('motive-card') ||
          (el.tagName === 'BUTTON' && !el.classList.contains('ent-btn') && !el.classList.contains('ent-link'))
        ) {
          target = el;
        }

        if (!target) return;
        scope.querySelectorAll('.is-on').forEach((n) => n.classList.remove('is-on'));
        target.classList.add('is-on');
      });
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting;
            root.classList.toggle('is-inview', inView && !reduced && !mobile);
            if (inView) {
              runCountUp();
              startLoop();
            } else {
              stopLoop();
            }
          });
        },
        { threshold: 0.28 },
      );
      io.observe(root);
    } else {
      inView = true;
      if (!reduced && !mobile) root.classList.add('is-inview');
      runCountUp();
      startLoop();
    }
  });
</script>
