---
/**
 * Enterprise-grade section visuals — clickable chrome, not functional.
 */
interface Props {
  variant: 'inbound' | 'outbound' | 'dialer' | 'backend' | 'motive';
}

const { variant } = Astro.props;

const ringing = [
  { name: 'Casey Ng', line: '+1 •••-2201' },
  { name: 'Sam Ortiz', line: '+1 •••-8842' },
];

const qualifying = [
  { name: 'Jordan Lee', step: 'Callback number', progress: 65 },
  { name: 'Priya Shah', step: 'Service type', progress: 40 },
];

const routing = [
  { name: 'Ava Brooks', dest: 'Sales · 2' },
  { name: 'Leo Park', dest: 'Dispatch · 4' },
];

const seatLanes = [
  { id: 'A', seats: ['bot', 'bot', 'bot', 'idle', 'bot', 'agent'] },
  { id: 'B', seats: ['bot', 'idle', 'bot', 'bot', 'bot', 'idle'] },
  { id: 'C', seats: ['agent', 'bot', 'bot', 'idle', 'bot', 'bot'] },
];

const seatCols = [1, 2, 3, 4, 5, 6];

const allSeats = seatLanes.flatMap((l) => l.seats);
const seatCounts = {
  bot: allSeats.filter((s) => s === 'bot').length,
  agent: allSeats.filter((s) => s === 'agent').length,
  idle: allSeats.filter((s) => s === 'idle').length,
  total: allSeats.length,
};

const voices = [
  { name: 'Sofia', meta: 'en-US · female', on: true },
  { name: 'Marcus', meta: 'en-US · male', on: false },
  { name: 'Amelia', meta: 'en-GB · clear', on: false },
];

const campaigns = [
  { code: 'ACA', name: 'Open Enrollment', status: 'Live', qual: '128', xfer: '41', rate: '32%', dials: '1,842', bar: 78, tone: 'aca' },
  { code: 'FE', name: 'Final Expense', status: 'Paused', qual: '62', xfer: '19', rate: '31%', dials: '940', bar: 54, tone: 'fe' },
  { code: 'HI', name: 'Health Insurance', status: 'Live', qual: '44', xfer: '11', rate: '25%', dials: '612', bar: 41, tone: 'hi' },
  { code: 'TD', name: 'Truck Dispatch', status: 'Live', qual: '37', xfer: '22', rate: '59%', dials: '488', bar: 66, tone: 'td' },
];

---

{
  variant === 'inbound' && (
    <div class="ent ent-rx" data-viz aria-label="Inbound receptionist board">
      <div class="ent-toolbar">
        <div>
          <p class="ent-kicker">Inbound</p>
          <h3>Reception board</h3>
        </div>
        <div class="ent-toolbar-actions">
          <span class="ent-status live">Answering</span>
          <button type="button" class="ent-btn solid" data-mock>Take next</button>
        </div>
      </div>

      <div class="ent-kpi-row rx-kpis">
        <button type="button" class="ent-kpi" data-mock>
          <span>Answered</span>
          <strong data-ent-count data-to="186" data-fmt="int">186</strong>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Avg qualify</span>
          <strong>0:48</strong>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Routed</span>
          <strong data-ent-count data-to="71" data-fmt="pct">71%</strong>
        </button>
      </div>

      <div class="rx-board">
        <div class="rx-col">
          <div class="rx-col-h"><span>Ringing</span><em>{ringing.length}</em></div>
          {ringing.map((c) => (
            <button type="button" class="rx-card" data-mock>
              <strong>{c.name}</strong>
              <em>{c.line}</em>
            </button>
          ))}
        </div>
        <div class="rx-col is-active">
          <div class="rx-col-h"><span>Qualifying</span><em>{qualifying.length}</em></div>
          {qualifying.map((c) => (
            <button type="button" class="rx-card is-on" data-mock>
              <strong>{c.name}</strong>
              <em>{c.step}</em>
              <div class="rx-progress"><i style={`width:${c.progress}%`} /></div>
            </button>
          ))}
        </div>
        <div class="rx-col">
          <div class="rx-col-h"><span>Route ready</span><em>{routing.length}</em></div>
          {routing.map((c) => (
            <button type="button" class="rx-card" data-mock>
              <strong>{c.name}</strong>
              <em>{c.dest}</em>
            </button>
          ))}
        </div>
      </div>

      <div class="rx-footer">
        <div>
          <strong>Bot asking Jordan</strong>
          <em>“What’s the best number to reach you on?”</em>
        </div>
        <div class="rx-footer-actions">
          <button type="button" class="ent-btn quiet" data-mock>Hold</button>
          <button type="button" class="ent-btn solid" data-mock>Route · Dispatch</button>
        </div>
      </div>
    </div>
  )
}

{
  variant === 'outbound' && (
    <div class="ent ent-outbound" data-viz aria-label="Outbound campaign table">
      <div class="ent-toolbar">
        <div>
          <p class="ent-kicker">Outbound</p>
          <h3>Campaign bots</h3>
        </div>
        <div class="ent-toolbar-actions">
          <button type="button" class="ent-btn quiet" data-mock>Filter</button>
          <button type="button" class="ent-btn solid" data-mock>Launch</button>
        </div>
      </div>

      <div class="ent-kpi-row out-kpis">
        <button type="button" class="ent-kpi" data-mock>
          <span>Dials today</span>
          <strong data-ent-count data-to="4283" data-fmt="comma">4,283</strong>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Qualified</span>
          <strong data-ent-count data-to="300" data-fmt="int">300</strong>
        </button>
        <button type="button" class="ent-kpi" data-mock>
          <span>Live bots</span>
          <strong data-ent-count data-to="18" data-fmt="int">18</strong>
        </button>
      </div>

      <div class="ent-table-wrap out-table">
        <table class="ent-table">
          <thead>
            <tr>
              <th>Campaign</th>
              <th>Status</th>
              <th>Dials</th>
              <th>Qualified</th>
              <th>Transfers</th>
              <th>Rate</th>
              <th>Pace</th>
            </tr>
          </thead>
          <tbody>
            {campaigns.map((c, i) => (
              <tr class:list={[{ 'is-on': i === 0 }]}>
                <td>
                  <button type="button" data-mock>
                    <span class={`ent-code tone-${c.tone}`}>{c.code}</span>
                    <strong>{c.name}</strong>
                  </button>
                </td>
                <td>
                  <span class:list={['ent-pill', { on: c.status === 'Live', off: c.status !== 'Live' }]}>
                    {c.status}
                  </span>
                </td>
                <td>{c.dials}</td>
                <td>{c.qual}</td>
                <td>{c.xfer}</td>
                <td>{c.rate}</td>
                <td>
                  <div class="ent-mini-bar" aria-hidden="true">
                    <i style={`width:${c.bar}%`} />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="out-detail">
        <div class="out-detail-main">
          <span class="ent-code tone-aca">ACA</span>
          <div>
            <strong>Open Enrollment</strong>
            <em>Script: subsidy gate v3 · humanized voice · self-paced</em>
          </div>
        </div>
        <div class="out-detail-actions">
          <button type="button" class="ent-btn quiet" data-mock>Edit script</button>
          <button type="button" class="ent-btn solid" data-mock>Monitor</button>
        </div>
      </div>
    </div>
  )
}

{
  variant === 'dialer' && (
    <div class="ent ent-sync" data-viz aria-label="Dialer pace and seat map">
      <div class="ent-toolbar">
        <div>
          <p class="ent-kicker">Dialer sync</p>
          <h3>Self-paced seats</h3>
        </div>
        <div class="ent-toolbar-actions">
          <span class="ent-status live">Connected</span>
          <button type="button" class="ent-btn quiet" data-mock>Configure</button>
        </div>
      </div>

      <div class="sync-pipe" role="presentation">
        <button type="button" class="sync-node" data-mock>
          <span>Dialer</span>
          <strong>Vicidial</strong>
        </button>
        <i class="sync-pipe-line" aria-hidden="true" />
        <button type="button" class="sync-node is-on" data-mock>
          <span>Bot layer</span>
          <strong>{seatCounts.bot} live</strong>
        </button>
        <i class="sync-pipe-line" aria-hidden="true" />
        <button type="button" class="sync-node" data-mock>
          <span>Agents</span>
          <strong>{seatCounts.agent} closers</strong>
        </button>
      </div>

      <div class="sync-hero">
        <button type="button" class="sync-pace" data-mock>
          <div class="sync-pace-top">
            <span>Live pace</span>
            <em>matched · Vicidial</em>
          </div>
          <strong>1.0×</strong>
          <div class="sync-meter" aria-hidden="true">
            <i style={`width:68%`} />
            <b style={`left:68%`} />
          </div>
        </button>
        <div class="sync-side-stats">
          <button type="button" data-mock><span>Handshake</span><strong>42ms</strong></button>
          <button type="button" data-mock><span>Queue lag</span><strong>0.2s</strong></button>
          <button type="button" data-mock><span>Ramp</span><strong>+6 seats</strong></button>
          <button type="button" data-mock><span>Endpoint</span><strong>prod-east</strong></button>
        </div>
      </div>

      <div class="sync-map-block">
        <div class="sync-map-h">
          <span>Floor map · {seatCounts.total} seats</span>
          <div class="sync-counts">
            <button type="button" data-mock><i class="bot" />{seatCounts.bot} bot</button>
            <button type="button" data-mock><i class="agent" />{seatCounts.agent} agent</button>
            <button type="button" data-mock><i class="idle" />{seatCounts.idle} idle</button>
          </div>
        </div>

        <div class="sync-floor" role="group" aria-label="Seat grid">
          <span class="sync-floor-corner" aria-hidden="true" />
          {seatCols.map((col) => (
            <span class="sync-floor-col">{col}</span>
          ))}

          {seatLanes.map((lane) => (
            <div class="sync-floor-lane">
              <span class="sync-floor-row">{lane.id}</span>
              {lane.seats.map((kind, i) => (
                <button
                  type="button"
                  class:list={['sync-seat', kind, { 'is-on': lane.id === 'A' && i === 0 }]}
                  data-mock
                  title={`Seat ${lane.id}${i + 1}`}
                  aria-label={`Seat ${lane.id}${i + 1}, ${kind}`}
                >
                  <em>{lane.id}{i + 1}</em>
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="sync-footer">
        <div>
          <strong>Seat A1 · bot owning opener</strong>
          <em>Dialer feeds pace · bots clear first contact · agents take warm only</em>
        </div>
        <button type="button" class="ent-btn solid" data-mock>View sync log</button>
      </div>
    </div>
  )
}

