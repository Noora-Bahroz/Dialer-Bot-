---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site } from '../data/site';
import { breadcrumbJsonLd, faqPageJsonLd } from '../data/seo';
import { definitionLong } from '../data/product';
import '../styles/global.css';
import '../styles/faqs-page.css';

export const prerender = true;

const faqs = [
  {
    id: 'what',
    topic: 'Product',
    q: 'What is Dialer Bot?',
    a: definitionLong,
  },
  {
    id: 'replace',
    topic: 'Product',
    q: 'Does Dialer Bot replace my human closers?',
    a: 'No. The bot is not the final salesperson. It handles the opening conversation and the qualification, then a human closer completes the conversation, verification, paperwork, and the actual sale.',
  },
  {
    id: 'flow',
    topic: 'Product',
    q: 'What happens on a call?',
    a: 'Your PC dialer starts the call. The bot detects whether a human, voicemail, an answering machine, or a honeypot picked up. If a human answers, it follows your business-specific script, asks the required qualification questions, checks whether the lead meets your criteria and is interested, and then live-transfers the call to a human closer. Every call ends with a recorded disposition.',
  },
  {
    id: 'detection',
    topic: 'Product',
    q: 'Can the bot tell if a human actually picked up?',
    a: 'Yes. The bot detects human answers, voicemail, answering machines, and honeypot or other automated responses, so your closers do not pick up a machine.',
  },
  {
    id: 'disposition',
    topic: 'Product',
    q: 'What is a disposition?',
    a: 'A disposition is the final status recorded for a call. Examples include callback, not interested, voicemail, answering machine, qualified or transferred, and other outcomes your campaign tracks.',
  },
  {
    id: 'scripts',
    topic: 'Product',
    q: 'Does every business get the same script?',
    a: 'No. Each business or campaign can have its own script and its own required qualification questions. The script stays consistent for that business while the conversation adapts to the answers given.',
  },
  {
    id: 'transfer',
    topic: 'Product',
    q: 'What is the difference between a live transfer and a cold transfer?',
    a: 'A live transfer hands the caller straight to a human closer while they are still on the line, with the context already collected. A cold transfer connects a caller with little or no context.',
  },
  {
    id: 'lock',
    topic: 'Product',
    q: 'Can we lock the first questions for compliance?',
    a: 'Yes. First questions can be hardcoded for compliance and QA, with adaptive follow-ups after intent forms.',
  },
  {
    id: 'dnc',
    topic: 'Product',
    q: 'Does Dialer Bot handle Do Not Call?',
    a: 'Yes. DNC means Do Not Call. The system checks whether a number is on a Do Not Call list before the call proceeds, and does not proceed where applicable.',
  },
  {
    id: 'voice',
    topic: 'Product',
    q: 'Can I use my own voice and other languages?',
    a: 'Yes. Dialer Bot supports high-quality AI voices, voice cloning for your brand, and multi-language campaigns.',
  },
  {
    id: 'address',
    topic: 'Product',
    q: 'Can the bot capture addresses or service locations?',
    a: 'Yes. Address capturing is a supported capability, so the details a campaign needs can be collected during the call and passed to the closer.',
  },
  {
    id: 'aca',
    topic: 'Product',
    q: 'Does Dialer Bot work for ACA campaigns?',
    a: 'Yes. ACA, FE, and HI are example use cases for the same qualification pattern. See the ACA voice bot solution page for the full pattern.',
  },
  {
    id: 'dispatch',
    topic: 'Product',
    q: 'Can it qualify truck dispatch calls?',
    a: 'Yes. Truck dispatch is one of the main industries. Dispatch questions cover things like equipment or load type, lane or geography, timing, and availability, and dispatchers only join the call when it is worth human time.',
  },
  {
    id: 'vault',
    topic: 'Product',
    q: 'Do you store recordings and transcripts?',
    a: 'Yes — searchable vault for ops review. Retention rules can be tuned on enterprise plans.',
  },
  {
    id: 'demo',
    topic: 'Buying',
    q: 'How do I try Dialer Bot before buying?',
    a: 'Open the live demo at demo.dialerbot.online, then WhatsApp sales if you want a script configured for your dialer.',
  },
  {
    id: 'price',
    topic: 'Buying',
    q: 'How much does Dialer Bot cost?',
    a: `Starter pricing is $${site.pricePerBot} USD per bot per month. Pricing is negotiated by volume, so larger bot counts are quoted based on your setup.`,
  },
  {
    id: 'what-is-a-bot',
    topic: 'Buying',
    q: 'What exactly is a bot?',
    a: 'A bot is an AI voice agent/bot that handles calls as part of the call-center workflow — the AI calling unit your call center runs.',
  },
  {
    id: 'how-many-bots',
    topic: 'Buying',
    q: 'How many bots does a call center need?',
    a: 'It depends on your agent count and campaign volume. Bots relate to your call-center capacity, but are generally fewer than the total number of human agents. For scale, 100 bots at the reference price is $3,500 per month before any volume discount.',
  },
  {
    id: 'enterprise',
    topic: 'Buying',
    q: 'When do we need enterprise instead of starter?',
    a: 'Choose enterprise when you need multi-bot scale, custom compliance workflows, or more campaign-level configuration than a single campaign script set.',
  },
  {
    id: 'dialer',
    topic: 'Ops',
    q: 'Do I have to replace my PC dialer?',
    a: 'No. Dialer Bot is designed to integrate with the PC dialer workflow your call center already runs. Confirm your specific stack on WhatsApp before you buy.',
  },
  {
    id: 'live',
    topic: 'Ops',
    q: 'How fast can we go live?',
    a: 'A focused campaign script set moves quickly once dialer access and required questions are clear — often days, not months, for a single lane.',
  },
  {
    id: 'qa',
    topic: 'Ops',
    q: 'How does Dialer Bot help QA?',
    a: 'Locked early turns keep scripts stable, and the transcript vault lets supervisors search what was said without sitting every call live.',
  },
  {
    id: 'where',
    topic: 'Company',
    q: 'Where is Dialer Bot based?',
    a: `Office 12, Pakistan Town Phase 2, Islamabad, Pakistan. WhatsApp ${site.phoneDisplay} · ${site.email}.`,
  },
  {
    id: 'contact',
    topic: 'Company',
    q: 'How do I contact sales?',
    a: `WhatsApp ${site.phoneDisplay}, email ${site.email}, or the contact form on dialerbot.online/contact.`,
  },
];

const topics = ['All', ...Array.from(new Set(faqs.map((f) => f.topic)))];
---

<BaseLayout
  title="FAQs | Dialer Bot"
  description="FAQs on Dialer Bot: what the AI voice bot does, call detection, lead qualification, live transfer to a human closer, dispositions, DNC, PC dialer support, pricing per bot, and contact."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'FAQs', path: '/faqs' },
    ]),
    faqPageJsonLd(faqs),
  ]}
>
  <Header slot="header" />

  <div class="fq">
    <header class="fq-mast page-mast" data-mast>
      <PageMastFx />
      <div class="fq-shell fq-mast__grid">
        <div class="fq-mast__copy">
          <nav class="fq-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>FAQs</span>
          </nav>
          <p class="fq-brand">Dialer Bot</p>
          <h1>Straight answers for floors that already dial</h1>
          <p class="fq-deck">
            Pricing, product, ops, and where we sit. If your question is not here, WhatsApp it — we reply on the same
            thread.
          </p>
          <div class="fq-actions">
            <a class="fq-btn fq-btn--solid" href={wa.general} target="_blank" rel="noopener noreferrer">
              Ask on WhatsApp
            </a>
            <a class="fq-btn fq-btn--ghost" href="/pricing">View pricing</a>
          </div>
        </div>

        <aside class="fq-mast__aside" aria-label="Browse by topic">
          <div class="fq-topics" data-fq-topics>
            <p class="fq-topics__label">Browse by topic</p>
            <div class="fq-topics__grid" role="tablist" aria-label="FAQ topics">
              {
                topics.map((t, i) => (
                  <button
                    type="button"
                    class:list={['fq-topic', { 'is-active': i === 0 }]}
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                    data-topic={t}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    <span class="fq-topic__name">{t}</span>
                    <span class="fq-topic__count">
                      {t === 'All' ? faqs.length : faqs.filter((f) => f.topic === t).length}
                    </span>
                  </button>
                ))
              }
            </div>
          </div>
        </aside>
      </div>
    </header>

    <section class="fq-section" aria-labelledby="fq-list-title">
      <div class="fq-shell">
        <div class="fq-section__head" data-reveal>
          <p class="fq-kicker">Answers</p>
          <h2 id="fq-list-title">
            <span data-fq-heading>All questions</span>
          </h2>
        </div>

        <div class="fq-list" data-fq-list data-reveal="up" style="--reveal-i:1">
          {
            faqs.map((item, i) => (
              <details class="fq-item" data-topic={item.topic} name="fq-accordion" open={i === 0}>
                <summary>
                  <span class="fq-item__topic">{item.topic}</span>
                  <span class="fq-item__q">{item.q}</span>
                  <span class="fq-item__icon" aria-hidden="true" />
                </summary>
                <div class="fq-item__body">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
        <p class="fq-empty" data-fq-empty hidden>Nothing in that topic — try All, or ask on WhatsApp.</p>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const topicsRoot = document.querySelector<HTMLElement>('[data-fq-topics]');
  const tabs = Array.from(topicsRoot?.querySelectorAll<HTMLButtonElement>('[data-topic]') || []);
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-fq-list] > details'));
  const empty = document.querySelector<HTMLElement>('[data-fq-empty]');
  const heading = document.querySelector<HTMLElement>('[data-fq-heading]');

  const setTopic = (topic: string) => {
    tabs.forEach((tab) => {
      const on = tab.dataset.topic === topic;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.tabIndex = on ? 0 : -1;
    });

    let visible = 0;
    let first: HTMLDetailsElement | null = null;
    items.forEach((item) => {
      const show = topic === 'All' || item.dataset.topic === topic;
      item.hidden = !show;
      if (!show) item.open = false;
      else {
        visible += 1;
        if (!first) first = item;
      }
    });

    if (first) {
      items.forEach((item) => {
        if (!item.hidden) item.open = item === first;
      });
    }

    if (heading) heading.textContent = topic === 'All' ? 'All questions' : `${topic} questions`;
    if (empty) empty.hidden = visible > 0;
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => setTopic(tab.dataset.topic || 'All'));
  });

  topicsRoot?.querySelector('.fq-topics__grid')?.addEventListener('keydown', (event) => {
    const e = event as KeyboardEvent;
    const current = tabs.findIndex((t) => t.classList.contains('is-active'));
    if (current < 0) return;
    let next = current;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (current + 1) % tabs.length;
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (current - 1 + tabs.length) % tabs.length;
    else return;
    e.preventDefault();
    tabs[next].focus();
    setTopic(tabs[next].dataset.topic || 'All');
  });
</script>
