---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageMastFx from '../../components/PageMastFx.astro';
import { posts } from '../../data/posts';
import { wa } from '../../data/site';
import { breadcrumbJsonLd } from '../../data/seo';
import '../../styles/global.css';
import '../../styles/blog-page.css';

export const prerender = true;

const [featured, ...rest] = posts;
const tags = ['All', ...Array.from(new Set(posts.map((p) => p.tag)))];

function formatDate(iso: string) {
  return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Blog | DialerBot"
  description="Practical ideas for AI-powered calling teams — qualification, dialers, voice AI, campaigns, QA, and sales operations."
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ])}
>
  <Header slot="header" />

  <div class="bl">
    <header class="bl-mast page-mast page-mast--compact" data-mast>
      <PageMastFx compact />
      <div class="bl-shell">
        <div class="bl-mast__top">
          <nav class="bl-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Blog</span>
          </nav>
          <p class="bl-brand">The DialerBot Blog</p>
        </div>

        <div class="bl-mast__title">
          <h1>Practical ideas for AI-powered calling teams.</h1>
          <p class="bl-deck">
            No AI hype. No generic chatbot articles. Just practical strategies for building, running, and improving AI
            voice campaigns inside real call-center operations.
          </p>
          <p class="bl-deck" style="margin-top:0.5rem;opacity:0.85">
            Qualification · Dialers · Voice AI · Campaigns · QA · Sales Operations
          </p>
        </div>

        <div class="bl-mast__bar">
          <div class="bl-filters" data-bl-filters role="tablist" aria-label="Filter by topic">
            {
              tags.map((t, i) => (
                <button
                  type="button"
                  class:list={['bl-filter', { 'is-active': i === 0 }]}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  data-tag={t}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {t}
                </button>
              ))
            }
          </div>
          <a class="bl-btn bl-btn--solid" href={wa.general} target="_blank" rel="noopener noreferrer">
            Talk to Us
          </a>
        </div>
      </div>
    </header>

    <section class="bl-section">
      <div class="bl-shell">
        {
          featured && (
            <a
              class="bl-feature"
              href={`/blog/${featured.slug}`}
              data-tag={featured.tag}
              data-bl-item
              data-reveal="scale"
            >
              <img src={featured.image} alt={featured.title} width="720" height="480" />
              <div class="bl-feature__copy">
                <span>{featured.tag}</span>
                <h2>{featured.title}</h2>
                <p>{featured.excerpt}</p>
                <em>
                  {formatDate(featured.date)} · {featured.author} · Read article →
                </em>
              </div>
            </a>
          )
        }

        <ul class="bl-grid" data-bl-list>
          {
            rest.map((post, i) => (
              <li data-tag={post.tag} data-bl-item data-reveal="up" data-lift style={`--reveal-i: ${i % 3}`}>
                <a href={`/blog/${post.slug}`}>
                  <img src={post.image} alt={post.title} width="640" height="400" loading="lazy" />
                  <div class="bl-grid__copy">
                    <span class="bl-grid__tag">{post.tag}</span>
                    <h3 class="bl-grid__title">{post.title}</h3>
                    <p class="bl-grid__meta">
                      {formatDate(post.date)} · {post.author}
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="bl-empty" data-bl-empty hidden>No posts in that topic yet.</p>

        <div style="text-align:center;margin-top:3rem" data-reveal>
          <p style="margin-bottom:1rem;font-size:1.1rem;font-weight:600">
            Have a calling problem you're trying to solve?
          </p>
          <a class="bl-btn bl-btn--solid" href={wa.general} target="_blank" rel="noopener noreferrer">
            Talk to Us
          </a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-bl-filters]');
  const tabs = Array.from(filters?.querySelectorAll<HTMLButtonElement>('[data-tag]') || []);
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-bl-item]'));
  const empty = document.querySelector<HTMLElement>('[data-bl-empty]');

  const setTag = (tag: string) => {
    tabs.forEach((tab) => {
      const on = tab.dataset.tag === tag;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.tabIndex = on ? 0 : -1;
    });

    let visible = 0;
    items.forEach((item) => {
      const show = tag === 'All' || item.dataset.tag === tag;
      item.hidden = !show;
      if (show) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => setTag(tab.dataset.tag || 'All'));
  });

  filters?.addEventListener('keydown', (event) => {
    const current = tabs.findIndex((t) => t.classList.contains('is-active'));
    if (current < 0) return;
    let next = current;
    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
    else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + tabs.length) % tabs.length;
    else return;
    event.preventDefault();
    tabs[next].focus();
    setTag(tabs[next].dataset.tag || 'All');
  });
</script>
