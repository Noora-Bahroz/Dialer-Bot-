---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/pricing-page.css';

export const prerender = true;

const starterIncludes = [
  'One AI bot',
  'One campaign rule set',
  'Easy script setup',
  'Finds good leads automatically',
  'Smooth call transfers',
  'Listen to past calls',
  'Connects to your dialer',
  'Basic campaign stats',
  'Direct setup help',
];

const enterpriseIncludes = [
  'Multiple AI bots',
  'Multiple campaigns at once',
  'Custom rules for your business',
  'Smart call routing',
  'Connects with any tool',
  'For very busy call centers',
  'Expert campaign help',
  'Priority support line',
  'Custom setup for your needs',
  'Special pricing for high volume',
];

const comparison = [
  { feature: 'AI Bot', starter: true, enterprise: true },
  { feature: 'Campaign Setup', starter: true, enterprise: true },
  { feature: 'Finds Good Leads', starter: true, enterprise: true },
  { feature: 'Smooth Transfers', starter: true, enterprise: true },
  { feature: 'Call Recordings', starter: true, enterprise: true },
  { feature: 'Call Transcripts', starter: true, enterprise: true },
  { feature: 'Dialer Integration', starter: true, enterprise: true },
  { feature: 'Multiple Campaigns', starter: false, enterprise: true },
  { feature: 'Multiple Bots', starter: false, enterprise: true },
  { feature: 'Smart Routing', starter: false, enterprise: true },
  { feature: 'Custom Connections', starter: false, enterprise: true },
  { feature: 'Priority Support', starter: false, enterprise: true },
  { feature: 'Volume Pricing', starter: false, enterprise: true },
];

const faqs = [
  {
    q: 'Does $35 cover everything?',
    a: 'No. The $35 is for the AI software. Things like phone line costs (telephony, SIP) are separate depending on your current setup.',
  },
  {
    q: 'Can I start small?',
    a: 'Yes. The Starter plan is perfect for testing one campaign before spending more.',
  },
  {
    q: 'Can you handle huge call centers?',
    a: 'Yes. The Enterprise plan is built for huge teams running many campaigns and bots at the same time.',
  },
  {
    q: 'Do I have to buy a new dialer?',
    a: 'No. DialerBot works with the calling software you already have.',
  },
  {
    q: 'Will you help me set it up?',
    a: 'Yes. We will help you connect everything and write your first script.',
  },
];
---

<BaseLayout
  title="AI Voice Bot Pricing | DialerBot"
  description={`AI outbound calling from $${site.pricePerBot}/bot per month. Start with one agent, scale campaigns when your floor is ready. Software pricing is separate from telephony usage.`}
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing' },
  ])}
>
  <Header slot="header" />

  <div class="pr">
    <header class="pr-mast page-mast" data-mast>
      <PageMastFx />
      <div class="pr-shell pr-mast__grid">
        <div class="pr-mast__copy">
          <nav class="pr-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Pricing</span>
          </nav>
          <p class="pr-brand">DialerBot</p>
          <h1>Start with one AI bot. Upgrade when you are ready.</h1>
          <p class="pr-deck">
            Start small with one simple AI bot for a single campaign. When you're ready, upgrade to handle massive call volumes and multiple teams.
          </p>
          <div class="pr-actions">
            <a class="pr-btn pr-btn--solid" href={demo.pricing} target="_blank" rel="noopener noreferrer">
              Try the Demo
            </a>
            <a class="pr-btn pr-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">
              Talk to Sales
            </a>
          </div>
        </div>

        <aside class="pr-mast__aside" aria-label="Starting price">
          <div class="pr-dial" data-pr-dial data-plan="starter">
            <div class="pr-dial__tabs" role="tablist" aria-label="Choose a plan">
              <button
                type="button"
                class="pr-dial__tab is-active"
                role="tab"
                aria-selected="true"
                data-plan-tab="starter"
                id="pr-tab-starter"
              >
                Starter
              </button>
              <button
                type="button"
                class="pr-dial__tab"
                role="tab"
                aria-selected="false"
                data-plan-tab="enterprise"
                id="pr-tab-enterprise"
              >
                Enterprise
              </button>
            </div>

            <div
              class="pr-dial__panel is-active"
              role="tabpanel"
              data-plan-panel="starter"
              aria-labelledby="pr-tab-starter"
            >
              <p class="pr-dial__amt">
                <span class="pr-dial__currency">$</span>
                <span class="pr-dial__num" data-pr-count>{site.pricePerBot}</span>
              </p>
              <p class="pr-dial__unit">per bot · software</p>
              <p class="pr-rail__detail" style="margin:0.75rem 0 1rem">
                Perfect for one campaign. Note: Phone line and usage costs are separate.
              </p>
              <a
                class="pr-btn pr-btn--solid pr-dial__cta"
                href={demo.pricingStarter}
                target="_blank"
                rel="noopener noreferrer"
              >
                Get Started
              </a>
            </div>

            <div
              class="pr-dial__panel"
              role="tabpanel"
              data-plan-panel="enterprise"
              aria-labelledby="pr-tab-enterprise"
              hidden
            >
              <p class="pr-dial__amt pr-dial__amt--lite">
                <span class="pr-dial__talk">Custom</span>
              </p>
              <p class="pr-dial__unit">Quoted for your floor</p>
              <p class="pr-rail__detail" style="margin:0.75rem 0 1rem">
                For big teams running many campaigns and custom setups.
              </p>
              <a
                class="pr-btn pr-btn--lime pr-dial__cta"
                href={wa.enterprise}
                target="_blank"
                rel="noopener noreferrer"
              >
                Talk to Sales
              </a>
            </div>
          </div>
        </aside>
      </div>
    </header>

    <section class="pr-section" aria-labelledby="pr-lanes-title">
      <div class="pr-shell">
        <div class="pr-section__head" data-reveal>
          <p class="pr-kicker">Plans</p>
          <h2 id="pr-lanes-title">Clear pricing for beginners. Custom plans for pros.</h2>
        </div>

        <div class="pr-lanes">
          <article class="pr-lane pr-lane--starter" data-reveal="left" data-lift>
            <header>
              <p class="pr-kicker">Starter</p>
              <h3>${site.pricePerBot} / bot</h3>
              <p class="pr-lane__price">
                <strong>Best for testing one campaign</strong>
                <span>or launching your first AI agent</span>
              </p>
            </header>
            <ul>
              {starterIncludes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="pr-lane__ctas">
              <a class="pr-btn pr-btn--solid" href={demo.pricingStarter} target="_blank" rel="noopener noreferrer">
                Get Started
              </a>
              <a class="pr-btn pr-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">
                Talk to Sales
              </a>
            </div>
          </article>

          <article class="pr-lane pr-lane--enterprise" data-reveal="right" data-lift style="--reveal-i:1">
            <header>
              <p class="pr-kicker pr-kicker--lime">Enterprise</p>
              <h3>Custom pricing</h3>
              <p class="pr-lane__price pr-lane__price--lite">
                <strong>For big teams</strong>
                <span>Priced for your needs</span>
              </p>
            </header>
            <ul>
              {enterpriseIncludes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="pr-btn pr-btn--lime" href={wa.enterprise} target="_blank" rel="noopener noreferrer">
              Talk to Sales
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="pr-section pr-section--tint" aria-labelledby="pr-compare-title">
      <div class="pr-shell">
        <div class="pr-section__head" data-reveal>
          <p class="pr-kicker">Comparison</p>
          <h2 id="pr-compare-title">What each plan includes</h2>
        </div>
        <div class="pr-include" style="display:block;overflow-x:auto" data-reveal>
          <table style="width:100%;border-collapse:collapse;font-size:0.95rem">
            <thead>
              <tr>
                <th style="text-align:left;padding:0.75rem;border-bottom:1px solid rgba(0,0,0,0.08)"></th>
                <th style="text-align:center;padding:0.75rem;border-bottom:1px solid rgba(0,0,0,0.08)">Starter</th>
                <th style="text-align:center;padding:0.75rem;border-bottom:1px solid rgba(0,0,0,0.08)">Enterprise</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((row) => (
                  <tr>
                    <td style="padding:0.65rem 0.75rem;border-bottom:1px solid rgba(0,0,0,0.06)">{row.feature}</td>
                    <td style="text-align:center;padding:0.65rem;border-bottom:1px solid rgba(0,0,0,0.06)">
                      {row.starter ? '✓' : '—'}
                    </td>
                    <td style="text-align:center;padding:0.65rem;border-bottom:1px solid rgba(0,0,0,0.06)">
                      {row.enterprise ? '✓' : '—'}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="pr-section" aria-labelledby="pr-faq-title">
      <div class="pr-shell">
        <div class="pr-section__head" data-reveal>
          <p class="pr-kicker">Pricing FAQ</p>
          <h2 id="pr-faq-title">Common Questions</h2>
        </div>
        <ol class="pr-steps">
          {
            faqs.map((item, i) => (
              <li data-reveal="up" style={`--reveal-i: ${i}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </li>
            ))
          }
        </ol>
        <div class="pr-actions" style="justify-content:center;margin-top:2.5rem" data-reveal>
          <a class="pr-btn pr-btn--solid" href={demo.pricing} target="_blank" rel="noopener noreferrer">
            Try DialerBot
          </a>
          <a class="pr-btn pr-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">
            Talk to Sales
          </a>
        </div>
        <p class="pr-deck" style="text-align:center;margin-top:1.25rem" data-reveal>
          Don't risk everything on day one. Try it on one campaign, see the results, and then grow.
        </p>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const dial = document.querySelector<HTMLElement>('[data-pr-dial]');
  if (dial) {
    const tabs = Array.from(dial.querySelectorAll<HTMLButtonElement>('[data-plan-tab]'));
    const panels = Array.from(dial.querySelectorAll<HTMLElement>('[data-plan-panel]'));

    const setPlan = (plan: string) => {
      dial.dataset.plan = plan;
      tabs.forEach((tab) => {
        const on = tab.dataset.planTab === plan;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const on = panel.dataset.planPanel === plan;
        panel.classList.toggle('is-active', on);
        panel.hidden = !on;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setPlan(tab.dataset.planTab || 'starter'));
    });
  }
</script>
