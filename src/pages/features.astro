---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd, definedTermJsonLd } from '../data/seo';
import { capabilities } from '../data/product';
import '../styles/global.css';
import '../styles/features-page.css';

export const prerender = true;

const featuresDefinition =
  'Dialer Bot features cover the first part of a call: AI voice conversations, business-specific scripts, lead qualification, call detection, live transfer to a human closer, dispositions, and PC dialer integration.';

const matrix = capabilities
  .filter((c) => c.primary)
  .map((c, i) => ({
    n: String(i + 1).padStart(2, '0'),
    title: c.name,
    text: c.plain,
  }));

const modules = [
  {
    kicker: 'Control the Script',
    title: 'Make sure important things are said.',
    body: 'Lock in specific phrases for legal or intro reasons, while still letting the AI chat naturally the rest of the time.',
    items: ['Lock important phrases', 'Keep the chat natural', 'Set custom rules per campaign'],
  },
  {
    kicker: 'Smart Answers',
    title: 'Handle unexpected replies.',
    body: 'The call does not stop if someone asks a weird question. The AI can clarify, handle doubts, and keep going.',
    items: ['Answer doubts', 'Ask clarifying questions', 'Decide when to transfer'],
  },
  {
    kicker: 'Send to the Right Person',
    title: 'Live-transfer to a closer.',
    body: 'Qualified and interested calls are transferred live to a human closer, who then completes the conversation, verification, paperwork, and the actual sale.',
    items: ['Live transfer to closers', 'Capture the details a campaign needs', 'Choose voices per campaign'],
  },
];
---

<BaseLayout
  title="AI Voice Bot Features | DialerBot"
  description="AI voice bot features for call centers — AI voice conversations, business-specific scripts, lead qualification, call detection, live transfer to a human closer, dispositions, and PC dialer integration."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Features', path: '/features' },
    ]),
    definedTermJsonLd('Dialer Bot features', featuresDefinition, '/features'),
  ]}
>
  <Header slot="header" />

  <div class="fx">
    <header class="fx-mast page-mast" data-mast>
      <PageMastFx />
      <div class="fx-shell fx-mast__grid">
        <div class="fx-mast__copy">
          <nav class="fx-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Features</span>
          </nav>
          <p class="fx-brand">Dialer Bot</p>
          <h1>Everything you need for the first call.</h1>
          <AeoDefinition term="Dialer Bot features" definition={featuresDefinition} tone="dark" />
          <p class="fx-deck">
            Detect who picked up, run your business-specific script, qualify the lead, and live-transfer the good ones to a human closer.
            Bots from ${site.pricePerBot} per month.
          </p>
          <div class="fx-actions">
            <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
              See Live Demo
            </a>
            <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
          </div>
        </div>

        <aside class="fx-mast__aside" aria-label="Feature snapshot">
          <div class="fx-snapshot">
            <div class="fx-snapshot__top">
              <p class="fx-snapshot__label">At a glance</p>
              <span class="fx-snapshot__badge">AI voice bot</span>
            </div>
            <dl class="fx-snapshot__grid">
              <div>
                <dt>Focus</dt>
                <dd>First call</dd>
              </div>
              <div>
                <dt>Modules</dt>
                <dd>{capabilities.filter((c) => c.primary).length} core capabilities</dd>
              </div>
              <div>
                <dt>Handoff</dt>
                <dd>Live transfer</dd>
              </div>
              <div>
                <dt>Sales path</dt>
                <dd>Live demo · WhatsApp</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="fx-section" aria-labelledby="fx-matrix-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">All Features</p>
          <h2 id="fx-matrix-title">Everything you need for better first calls.</h2>
          <p class="fx-section__deck">
            Plainly explained, so you can see what the bot does before it reaches a call.
          </p>
        </div>

        <ul class="fx-matrix">
          {
            matrix.map((item, i) => (
              <li class="fx-matrix__cell" data-reveal="up" data-lift style={`--reveal-i: ${i % 4}`}>
                <span class="fx-matrix__n">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="fx-section fx-section--tint" aria-labelledby="fx-modules-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">Advanced Tools</p>
          <h2 id="fx-modules-title">Built for call centers that run lots of calls.</h2>
          <p class="fx-section__deck">
            Control your scripts, handle unexpected answers, and live-transfer qualified calls to the right closer.
          </p>
        </div>

        <div class="fx-arch" aria-label="Advanced capabilities">
          <div class="fx-arch__flow" data-reveal>
            <span>Detect</span>
            <i aria-hidden="true"></i>
            <span>Qualify</span>
            <i aria-hidden="true"></i>
            <span>Live transfer</span>
          </div>

          <div class="fx-arch__grid">
            {
              modules.map((mod, i) => (
                <article class="fx-arch-card" data-reveal="up" style={`--reveal-i: ${i}`}>
                  <div class="fx-arch-card__head">
                    <span class="fx-arch-card__index">Layer {String(i + 1).padStart(2, '0')}</span>
                    <p class="fx-kicker">{mod.kicker}</p>
                  </div>
                  <h3>{mod.title}</h3>
                  <p>{mod.body}</p>
                  <ul>
                    {mod.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div class="fx-actions" style="justify-content:center;margin-top:2.5rem" data-reveal>
          <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
            Launch Live Demo
          </a>
          <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
