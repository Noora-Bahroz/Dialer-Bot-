---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site } from '../data/site';
import '../styles/global.css';
import '../styles/features-page.css';

const matrix = [
  {
    n: '01',
    title: 'Intent scoring',
    text: 'Every answer moves a live score. Soft maybes stay with the bot; hard yeses transfer warm.',
  },
  {
    n: '02',
    title: 'Opener packs',
    text: 'Version ACA, FE, HI, and dispatch openers. A/B packs, freeze winners, retire duds.',
  },
  {
    n: '03',
    title: 'Compliance gates',
    text: 'Consent, quiet hours, and DNC checks run before the pitch — bad calls never hit a seat.',
  },
  {
    n: '04',
    title: 'Voice roster',
    text: 'Swap language and voice per campaign without rewriting qualification logic.',
  },
  {
    n: '05',
    title: 'Transcript vault',
    text: 'Searchable audio and text so ops find ZIP or intent labels in seconds.',
  },
  {
    n: '06',
    title: 'Affinity routing',
    text: 'Warm handoffs prefer the seat that already owns that book of business.',
  },
  {
    n: '07',
    title: 'Disposition hooks',
    text: 'Push qualified, callback, DNC, and dead into CRM the moment the bot decides.',
  },
  {
    n: '08',
    title: 'Pace governor',
    text: 'Cap concurrent bots to dialer RPM and throttle when agent seats saturate.',
  },
];

const modules = [
  {
    kicker: 'Qualification',
    title: 'Hardcoded first questions. Flexible follow-ups.',
    body: 'Turns one through three stay locked for QA and compliance. After intent starts to form, Dialer Bot clarifies hesitation and only escalates when the score crosses your handoff threshold.',
    items: ['Script lock on early turns', 'Adaptive clarification loops', 'Configurable handoff score'],
  },
  {
    kicker: 'Operations',
    title: 'Built for people who live in dialers.',
    body: 'Supervisors monitor live status and pull vault clips without leaving the ops rhythm they already have. Agents inherit context — what was asked, what was confirmed, why the lead is worth time.',
    items: ['Live monitoring hooks', 'Warm context on transfer', 'Seat-level affinity rules'],
  },
  {
    kicker: 'Reliability',
    title: 'When the line matters, the bot stays on it.',
    body: 'Health checks and graceful degrade paths keep qualification running when a trunk or model endpoint hiccups — with alerts before the floor feels dead air.',
    items: ['Endpoint health pings', 'Failover routing', 'Ops-facing alert hooks'],
  },
];
---

<BaseLayout
  title="Features | Dialer Bot"
  description="Dialer Bot features — intent scoring, opener packs, compliance, vault, routing, and pace control for calling floors."
>
  <Header slot="header" />

  <main class="fx">
    <!-- Masthead: single composition, brand-led -->
    <header class="fx-mast page-mast" data-mast>
      <PageMastFx />
      <div class="fx-shell fx-mast__grid">
        <div class="fx-mast__copy">
          <nav class="fx-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Features</span>
          </nav>
          <p class="fx-brand">Dialer Bot</p>
          <h1>Platform features for floors that already dial</h1>
          <p class="fx-deck">
            The controls under qualification — scoring, scripting, compliance, vault, routing, and pace.
            Starter bots from ${site.pricePerBot}.
          </p>
          <div class="fx-actions">
            <a class="fx-btn fx-btn--solid" href={wa.start} target="_blank" rel="noopener noreferrer">
              WhatsApp to start
            </a>
            <a class="fx-btn fx-btn--ghost" href="/pricing">View pricing</a>
          </div>
        </div>

        <aside class="fx-mast__aside" aria-label="Feature snapshot">
          <div class="fx-snapshot">
            <div class="fx-snapshot__top">
              <p class="fx-snapshot__label">At a glance</p>
              <span class="fx-snapshot__badge">Live layer</span>
            </div>
            <dl class="fx-snapshot__grid">
              <div>
                <dt>Surface</dt>
                <dd>Qualification layer</dd>
              </div>
              <div>
                <dt>Modules</dt>
                <dd>8 core controls</dd>
              </div>
              <div>
                <dt>Handoff</dt>
                <dd>Warm · scored</dd>
              </div>
              <div>
                <dt>Sales path</dt>
                <dd>WhatsApp</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <!-- Symmetric capability matrix -->
    <section class="fx-section" aria-labelledby="fx-matrix-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">Capability matrix</p>
          <h2 id="fx-matrix-title">Eight controls. One qualification layer.</h2>
          <p class="fx-section__deck">
            Equal weight, equal cells — every module ops can actually configure.
          </p>
        </div>

        <ul class="fx-matrix">
          {
            matrix.map((item, i) => (
              <li class="fx-matrix__cell" data-reveal="up" data-lift style={`--reveal-i: ${i % 4}`}>
                <span class="fx-matrix__n">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Detail modules: same column rhythm every time -->
    <section class="fx-section fx-section--tint" aria-labelledby="fx-modules-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">How it holds together</p>
          <h2 id="fx-modules-title">Three layers behind the matrix</h2>
        </div>

        <div class="fx-modules">
          {
            modules.map((mod, i) => (
              <article class="fx-module" data-reveal="left" style={`--reveal-i: ${i}`}>
                <div class="fx-module__label">
                  <p class="fx-kicker">{mod.kicker}</p>
                </div>
                <div class="fx-module__body">
                  <h3>{mod.title}</h3>
                  <p>{mod.body}</p>
                  <ul>
                    {mod.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

  </main>

  <Footer slot="footer" />
</BaseLayout>
