---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd, definedTermJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/features-page.css';

export const prerender = true;

const featuresDefinition =
  'DialerBot features help call centers build, launch, monitor, and improve AI voice campaigns — from the first greeting to the final handoff.';

const matrix = [
  {
    n: '01',
    title: 'AI Voice Conversations',
    text: 'Your bot can hold a real conversation — listen, understand responses, ask follow-ups, and keep the call moving.',
  },
  {
    n: '02',
    title: 'Campaign Scripts',
    text: 'Create a separate conversation flow for every campaign: opening message, questions, objections, transfer and end-call rules.',
  },
  {
    n: '03',
    title: 'Qualification & Intent',
    text: 'Set the criteria that define a qualified conversation. Qualified → transfer. Uncertain → continue. Not qualified → end or disposition.',
  },
  {
    n: '04',
    title: 'Warm Transfer',
    text: 'Transfer to a human agent with the context collected during the AI conversation — not a cold “how can I help you?” start.',
  },
  {
    n: '05',
    title: 'Dialer Integration',
    text: 'Connect DialerBot with your existing dialer, SIP environment, or calling infrastructure. AI operates as the conversation layer.',
  },
  {
    n: '06',
    title: 'Call Recording & Transcripts',
    text: 'Review recordings, transcripts, lead responses, disposition, transfer reason, campaign, and call outcome for QA.',
  },
  {
    n: '07',
    title: 'Campaign Management',
    text: 'Run different AI agents for different campaigns — each with its own voice, script, qualification rules, and operating hours.',
  },
  {
    n: '08',
    title: 'Monitoring & Analytics',
    text: 'Monitor calls, active conversations, qualified leads, transfers, completed calls, and campaign outcomes over time.',
  },
];

const modules = [
  {
    kicker: 'Script Control',
    title: 'Keep critical language consistent.',
    body: 'Keep opening questions and compliance language consistent while allowing the AI to respond naturally around them.',
    items: ['Locked critical turns', 'Natural follow-up responses', 'Campaign-specific rules'],
  },
  {
    kicker: 'Smart Follow-Ups',
    title: 'Handle unexpected answers.',
    body: 'The conversation does not have to end when a prospect gives an unexpected answer. Clarify, handle objections, and continue qualification.',
    items: ['Objection handling', 'Clarifying questions', 'Continue or transfer logic'],
  },
  {
    kicker: 'Agent Routing',
    title: 'Send the right calls to the right team.',
    body: 'Send qualified calls to the appropriate team, campaign, or agent — with CRM and webhook connections for the systems you already use.',
    items: ['Team / campaign routing', 'CRM & webhooks', 'Voice and language per campaign'],
  },
];
---

<BaseLayout
  title="Features | DialerBot"
  description="Everything you need to automate the first conversation — AI voice campaigns, qualification, warm transfers, dialer integration, and monitoring."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Features', path: '/features' },
    ]),
    definedTermJsonLd('DialerBot features', featuresDefinition, '/features'),
  ]}
>
  <Header slot="header" />

  <div class="fx">
    <header class="fx-mast page-mast" data-mast>
      <PageMastFx />
      <div class="fx-shell fx-mast__grid">
        <div class="fx-mast__copy">
          <nav class="fx-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Features</span>
          </nav>
          <p class="fx-brand">DialerBot</p>
          <h1>Everything you need to automate the first conversation.</h1>
          <AeoDefinition term="DialerBot features" definition={featuresDefinition} tone="dark" />
          <p class="fx-deck">
            Build, launch, monitor, and improve AI voice campaigns — from the first greeting to the final handoff.
            Starter bots from ${site.pricePerBot}.
          </p>
          <div class="fx-actions">
            <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
              See Live Demo
            </a>
            <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
          </div>
        </div>

        <aside class="fx-mast__aside" aria-label="Feature snapshot">
          <div class="fx-snapshot">
            <div class="fx-snapshot__top">
              <p class="fx-snapshot__label">At a glance</p>
              <span class="fx-snapshot__badge">AI voice platform</span>
            </div>
            <dl class="fx-snapshot__grid">
              <div>
                <dt>Focus</dt>
                <dd>First conversation</dd>
              </div>
              <div>
                <dt>Modules</dt>
                <dd>8 core capabilities</dd>
              </div>
              <div>
                <dt>Handoff</dt>
                <dd>Warm transfer</dd>
              </div>
              <div>
                <dt>Sales path</dt>
                <dd>Live demo · WhatsApp</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="fx-section" aria-labelledby="fx-matrix-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">Feature grid</p>
          <h2 id="fx-matrix-title">Eight capabilities. One calling workflow.</h2>
          <p class="fx-section__deck">
            Clear tools for operators evaluating DialerBot — without internal jargon getting in the way.
          </p>
        </div>

        <ul class="fx-matrix">
          {
            matrix.map((item, i) => (
              <li class="fx-matrix__cell" data-reveal="up" data-lift style={`--reveal-i: ${i % 4}`}>
                <span class="fx-matrix__n">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="fx-section fx-section--tint" aria-labelledby="fx-modules-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">Advanced</p>
          <h2 id="fx-modules-title">Built around the way call centers actually operate.</h2>
          <p class="fx-section__deck">
            Script control, smart follow-ups, routing, CRM connections, voice configuration, and reliability —
            designed for high-volume floors.
          </p>
        </div>

        <div class="fx-arch" aria-label="Advanced capabilities">
          <div class="fx-arch__flow" data-reveal>
            <span>Script</span>
            <i aria-hidden="true"></i>
            <span>Follow-up</span>
            <i aria-hidden="true"></i>
            <span>Route</span>
          </div>

          <div class="fx-arch__grid">
            {
              modules.map((mod, i) => (
                <article class="fx-arch-card" data-reveal="up" style={`--reveal-i: ${i}`}>
                  <div class="fx-arch-card__head">
                    <span class="fx-arch-card__index">Layer {String(i + 1).padStart(2, '0')}</span>
                    <p class="fx-kicker">{mod.kicker}</p>
                  </div>
                  <h3>{mod.title}</h3>
                  <p>{mod.body}</p>
                  <ul>
                    {mod.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div class="fx-actions" style="justify-content:center;margin-top:2.5rem" data-reveal>
          <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
            Launch Live Demo
          </a>
          <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
