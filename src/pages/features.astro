---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd, definedTermJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/features-page.css';

export const prerender = true;

const featuresDefinition =
  'DialerBot features help you easily build, run, and track AI phone campaigns — from the first hello to the final transfer.';

const matrix = [
  {
    n: '01',
    title: 'Natural Conversations',
    text: 'Your bot talks like a real person. It listens, answers, and asks follow-up questions to keep the call going.',
  },
  {
    n: '02',
    title: 'Custom Scripts',
    text: 'Write a unique script for each campaign. Decide what the bot says, what it asks, and when it transfers a call.',
  },
  {
    n: '03',
    title: 'Find the Best Leads',
    text: 'Tell the bot what makes a good lead. Good leads get transferred, unsure ones get more questions, and bad leads are dropped.',
  },
  {
    n: '04',
    title: 'Smooth Transfers',
    text: 'When a lead is ready, the bot transfers them to a human along with all the notes. No more cold starts.',
  },
  {
    n: '05',
    title: 'Easy Connection',
    text: 'Link DialerBot right into the calling software you already use. It acts as a helpful add-on, not a replacement.',
  },
  {
    n: '06',
    title: 'Listen to Calls',
    text: 'Read text versions of calls and listen to recordings so you can see exactly how your campaigns are doing.',
  },
  {
    n: '07',
    title: 'Manage Campaigns',
    text: 'Run different bots for different jobs. Each one can have its own voice, rules, and working hours.',
  },
  {
    n: '08',
    title: 'Track Performance',
    text: 'See live updates on active calls, good leads, successful transfers, and overall campaign results.',
  },
];

const modules = [
  {
    kicker: 'Control the Script',
    title: 'Make sure important things are said.',
    body: 'Lock in specific phrases for legal or intro reasons, while still letting the AI chat naturally the rest of the time.',
    items: ['Lock important phrases', 'Keep the chat natural', 'Set custom rules per campaign'],
  },
  {
    kicker: 'Smart Answers',
    title: 'Handle unexpected replies.',
    body: 'The call does not stop if someone asks a weird question. The AI can clarify, handle doubts, and keep going.',
    items: ['Answer doubts', 'Ask clarifying questions', 'Decide when to transfer'],
  },
  {
    kicker: 'Send to the Right Person',
    title: 'Route calls correctly.',
    body: 'Send good leads to the right team or person, and automatically save their info in your customer database.',
    items: ['Route to teams or agents', 'Connect to your CRM', 'Choose voices per campaign'],
  },
];
---

<BaseLayout
  title="AI Outbound Calling Features | DialerBot"
  description="AI outbound calling features for dialer floors — voice campaigns, lead qualification, warm handoffs, dialer integration, recordings, and supervisor monitoring."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Features', path: '/features' },
    ]),
    definedTermJsonLd('DialerBot features', featuresDefinition, '/features'),
  ]}
>
  <Header slot="header" />

  <div class="fx">
    <header class="fx-mast page-mast" data-mast>
      <PageMastFx />
      <div class="fx-shell fx-mast__grid">
        <div class="fx-mast__copy">
          <nav class="fx-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Features</span>
          </nav>
          <p class="fx-brand">DialerBot</p>
          <h1>Everything you need to automate the first conversation.</h1>
          <AeoDefinition term="DialerBot features" definition={featuresDefinition} tone="dark" />
          <p class="fx-deck">
            Easily build, launch, and track AI phone campaigns — from the first hello to the final transfer.
            Starter bots from ${site.pricePerBot}.
          </p>
          <div class="fx-actions">
            <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
              See Live Demo
            </a>
            <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
          </div>
        </div>

        <aside class="fx-mast__aside" aria-label="Feature snapshot">
          <div class="fx-snapshot">
            <div class="fx-snapshot__top">
              <p class="fx-snapshot__label">At a glance</p>
              <span class="fx-snapshot__badge">AI voice platform</span>
            </div>
            <dl class="fx-snapshot__grid">
              <div>
                <dt>Focus</dt>
                <dd>First conversation</dd>
              </div>
              <div>
                <dt>Modules</dt>
                <dd>8 core capabilities</dd>
              </div>
              <div>
                <dt>Handoff</dt>
                <dd>Warm transfer</dd>
              </div>
              <div>
                <dt>Sales path</dt>
                <dd>Live demo · WhatsApp</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="fx-section" aria-labelledby="fx-matrix-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">All Features</p>
          <h2 id="fx-matrix-title">Everything you need for better calls.</h2>
          <p class="fx-section__deck">
            Simple tools to help you manage calls and grow your business without confusing tech terms.
          </p>
        </div>

        <ul class="fx-matrix">
          {
            matrix.map((item, i) => (
              <li class="fx-matrix__cell" data-reveal="up" data-lift style={`--reveal-i: ${i % 4}`}>
                <span class="fx-matrix__n">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="fx-section fx-section--tint" aria-labelledby="fx-modules-title">
      <div class="fx-shell">
        <div class="fx-section__head" data-reveal>
          <p class="fx-kicker">Advanced Tools</p>
          <h2 id="fx-modules-title">Built for teams that make a lot of calls.</h2>
          <p class="fx-section__deck">
            Control your scripts, handle unexpected answers, and send calls to the right place. Perfect for busy teams.
          </p>
        </div>

        <div class="fx-arch" aria-label="Advanced capabilities">
          <div class="fx-arch__flow" data-reveal>
            <span>Script</span>
            <i aria-hidden="true"></i>
            <span>Follow-up</span>
            <i aria-hidden="true"></i>
            <span>Route</span>
          </div>

          <div class="fx-arch__grid">
            {
              modules.map((mod, i) => (
                <article class="fx-arch-card" data-reveal="up" style={`--reveal-i: ${i}`}>
                  <div class="fx-arch-card__head">
                    <span class="fx-arch-card__index">Layer {String(i + 1).padStart(2, '0')}</span>
                    <p class="fx-kicker">{mod.kicker}</p>
                  </div>
                  <h3>{mod.title}</h3>
                  <p>{mod.body}</p>
                  <ul>
                    {mod.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div class="fx-actions" style="justify-content:center;margin-top:2.5rem" data-reveal>
          <a class="fx-btn fx-btn--solid" href={demo.features} target="_blank" rel="noopener noreferrer">
            Launch Live Demo
          </a>
          <a class="fx-btn fx-btn--ghost" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
