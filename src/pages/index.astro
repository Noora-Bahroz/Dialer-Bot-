---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureConsoleMock from '../components/FeatureConsoleMock.astro';
import WarmHandoffMock from '../components/WarmHandoffMock.astro';
import HeroOrbitMock from '../components/HeroOrbitMock.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, demo } from '../data/site';
import { definedTermJsonLd, webPageJsonLd } from '../data/seo';
import '../styles/global.css';

export const prerender = true;

const dialerBotDefinition =
  'DialerBot is an AI voice platform for call centers. Your dialer finds the calls; DialerBot handles the first conversation; your agents talk only to qualified people.';

const benefitFeatures = [
  {
    icon: '/images/dialerbot-elements.svg',
    title: 'AI handles the first conversation',
    text: 'Greeting, qualification questions, intent, and basic information — so agents are not stuck on the same five questions all day.',
  },
  {
    icon: '/images/dialerbot-elements-1.svg',
    title: 'Your agents handle the close',
    text: 'Interested leads, complex questions, negotiation, and customer conversations reach humans with context already collected.',
  },
];

const howItWorks = [
  {
    n: '01',
    title: 'Connect your calling system',
    text: 'Keep the workflow your team already knows. Connect DialerBot to your dialer, SIP infrastructure, or calling environment.',
  },
  {
    n: '02',
    title: 'Give the bot your campaign',
    text: 'Define your script, qualification questions, rules, transfer conditions, and campaign goals.',
  },
  {
    n: '03',
    title: 'AI talks to the lead',
    text: 'DialerBot speaks naturally, asks questions, understands responses, and follows the conversation instead of simply reading a script.',
  },
  {
    n: '04',
    title: 'Qualify the conversation',
    text: 'The bot determines whether the lead meets your criteria and records the relevant information.',
  },
  {
    n: '05',
    title: 'Transfer the right calls',
    text: 'Qualified conversations can be transferred to the appropriate human agent with the information collected by the bot.',
  },
  {
    n: '06',
    title: 'Review everything',
    text: 'Keep call records, transcripts, outcomes, and campaign information in one place for monitoring and QA.',
  },
];

const valueProps = [
  {
    title: 'Qualify before a human picks up',
    text: 'Let AI handle the repetitive first stage of every campaign and reduce the number of low-value conversations reaching your agents.',
  },
  {
    title: 'Keep your existing dialer',
    text: 'DialerBot is designed to work alongside the infrastructure your call center already uses instead of forcing you to replace your entire stack.',
  },
  {
    title: 'Warm-transfer qualified leads',
    text: "Don't send an agent into a conversation blind. Transfer the call with the relevant context already collected.",
  },
  {
    title: 'Run campaigns around the clock',
    text: 'Use AI for outbound campaigns, inbound reception, overflow handling, callbacks, lead qualification, and other repetitive calling workflows.',
  },
];

const spotlights = [
  {
    image: '/images/dialerbot-home-01.webp',
    title: 'Inbound reception that answers and routes',
  },
  {
    image: '/images/dialerbot-home-02.webp',
    title: 'Outbound campaigns that qualify before the transfer',
  },
  {
    image: '/images/dialerbot-home-03.webp',
    title: 'Recordings, transcripts, and campaign monitoring',
  },
];

const serviceRows = [
  {
    reverse: false,
    label: 'Outbound Sales',
    title: 'Let AI make first contact',
    points: [
      { icon: '/images/dialerbot-radial.svg', text: 'AI opens the call and qualifies the prospect' },
      { icon: '/images/dialerbot-target-02.svg', text: 'Interested leads transfer to your sales team' },
      { icon: '/images/dialerbot-crowdfunding.svg', text: 'Unqualified conversations end without burning a seat' },
      { icon: '/images/dialerbot-computer-dollar.svg', text: 'Built for high-volume outbound floors' },
    ],
    mock: 'outbound' as const,
    cta: 'See outbound in demo',
  },
  {
    reverse: true,
    label: 'Inbound Reception',
    title: 'Answer, collect, and route',
    points: [
      { icon: '/images/dialerbot-elements.svg', text: 'Answer incoming calls around the clock' },
      { icon: '/images/dialerbot-elements-2.svg', text: 'Collect information and identify what the caller needs' },
      { icon: '/images/dialerbot-elements-3.svg', text: 'Route the conversation to the right person' },
      { icon: '/images/dialerbot-analysis-text-link.svg', text: 'Keep overflow and after-hours calls from falling through' },
    ],
    mock: 'inbound' as const,
    cta: 'See inbound in demo',
  },
  {
    reverse: false,
    label: 'Dialer Integration',
    title: 'Work with the stack you already run',
    points: [
      { icon: '/images/dialerbot-elements-4.svg', text: 'Connect to your dialer, SIP, or calling environment' },
      { icon: '/images/dialerbot-discover-circle.svg', text: 'Keep the workflow your team already knows' },
      { icon: '/images/dialerbot-bulb-charge.svg', text: 'AI operates as the conversation layer — not a full stack replacement' },
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Scale campaigns without rebuilding your floor' },
    ],
    mock: 'dialer' as const,
    cta: 'Talk about your dialer',
  },
  {
    reverse: true,
    label: 'Campaign Control',
    title: 'Scripts, rules, and monitoring in one place',
    points: [
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Natural AI conversations instead of rigid IVR flows' },
      { icon: '/images/dialerbot-clock.svg', text: 'Campaign-specific scripts, questions, and outcomes' },
      { icon: '/images/dialerbot-hourglass.svg', text: 'Recordings, transcripts, and call outcomes for QA' },
      { icon: '/images/dialerbot-paragraph-bullets-point-01.svg', text: 'Monitor active calls, transfers, and campaign results' },
    ],
    mock: 'backend' as const,
    cta: 'Explore platform features',
  },
];

const featuresList = [
  { title: 'Natural AI conversations', text: 'Give prospects a real conversational experience instead of a rigid IVR-style flow.' },
  { title: 'Campaign-specific scripts', text: 'Create different questions, rules, prompts, and outcomes for each campaign.' },
  { title: 'Qualification and intent scoring', text: 'Determine whether a conversation meets your criteria before involving a human agent.' },
  { title: 'Warm transfers', text: 'Send qualified calls directly to the right agent with context.' },
  { title: 'Call recordings and transcripts', text: 'Review conversations, investigate outcomes, and improve campaign performance.' },
  { title: 'Dialer integration', text: 'Connect DialerBot to your existing calling infrastructure.' },
  { title: 'Campaign monitoring', text: 'See active calls, campaign activity, transfers, and outcomes.' },
  { title: 'CRM integration', text: 'Push lead status, dispositions, collected information, and outcomes into your workflow.' },
];

const useCases = [
  { title: 'Outbound Sales', text: 'Let AI make the first contact, qualify the prospect, and transfer interested leads to your sales team.' },
  { title: 'Lead Qualification', text: 'Ask your qualification questions consistently on every call and pass the results to your CRM or agents.' },
  { title: 'Inbound Reception', text: 'Answer incoming calls, collect information, identify what the caller needs, and route the conversation.' },
  { title: 'Insurance Campaigns', text: 'Build campaign-specific qualification flows for insurance and other structured sales operations.' },
  { title: 'Dispatch', text: 'Handle initial questions, collect essential information, and route calls that require a dispatcher.' },
  { title: 'Custom Campaigns', text: 'Build the conversation around your own script, questions, rules, and transfer logic.' },
];

const callCenterNeeds = [
  'High-volume calling',
  'Campaign-specific conversations',
  'Qualification logic',
  'Fast transfers',
  'Call monitoring',
  'Agent workflows',
  'Dialer integration',
];
---

<BaseLayout
  title="DialerBot | AI Voice Agents for Call Centers"
  description="Your dialer finds the calls. DialerBot handles the first conversation. Your agents talk only to qualified people."
  image="/images/dialerbot-home-01.webp"
  preloadImages={['/images/dialerbot-bg-image.webp']}
  jsonLd={[
    webPageJsonLd({
      name: 'DialerBot | AI Voice Agents for Call Centers',
      description:
        'Your dialer finds the calls. DialerBot handles the first conversation. Your agents talk only to qualified people.',
      path: '/',
    }),
    definedTermJsonLd('DialerBot', dialerBotDefinition, '/'),
  ]}
>
  <Header slot="header" />

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="announcement">
            <span class="badge">AI</span>
            <p>AI Voice Agents for Call Centers</p>
            <span class="arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <h1>Let AI handle the first conversation. Let your agents handle the close.</h1>
          <p class="lead">
            DialerBot works with your existing calling workflow to answer calls, speak with leads, ask your
            qualification questions, understand responses, and transfer qualified conversations to your human agents.
          </p>
          <p class="lead" style="opacity:0.9;margin-top:0.75rem;font-weight:600">
            More qualified conversations. Less time wasted on unqualified calls.
          </p>
          <div class="hero-actions">
            <a class="btn btn-white" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try Live Demo</a>
            <a class="btn btn-glass" href={wa.start} target="_blank" rel="noopener noreferrer">
              Talk to Sales
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
          <p style="margin:1rem 0 0;font-size:0.85rem;opacity:0.75;max-width:36rem;line-height:1.45">
            Built for inbound and outbound calling teams. Connect your dialer, configure your campaign, and put your AI
            agent to work.
          </p>
        </div>
        <div class="hero-visual" data-reveal="right" style="--reveal-i:0">
          <HeroOrbitMock />
        </div>
      </div>
    </div>
  </section>

  <section class="aeo-solutions wrap" aria-label="DialerBot promise">
    <p class="section-label" data-reveal>The promise</p>
    <h2 class="section-title" data-reveal style="--reveal-i:1">
      Your dialer finds the calls. DialerBot handles the conversation. Your agents close the opportunities.
    </h2>
    <div data-reveal style="--reveal-i:1.5">
      <AeoDefinition term="DialerBot" definition={dialerBotDefinition} />
    </div>
    <div class="aeo-solutions__grid">
      <a class="aeo-solutions__card" href="/solutions/warm-handoff" data-reveal="up" style="--reveal-i:0">
        <strong>Warm transfer</strong>
        <span>Qualified conversations reach agents with context — not cold dumps.</span>
      </a>
      <a class="aeo-solutions__card" href="/features" data-reveal="up" style="--reveal-i:1">
        <strong>Campaign control</strong>
        <span>Scripts, qualification rules, monitoring, and recordings in one platform.</span>
      </a>
      <a class="aeo-solutions__card" href="/pricing" data-reveal="up" style="--reveal-i:2">
        <strong>Start with one bot</strong>
        <span>From $35 per bot. Scale when your floor is ready.</span>
      </a>
    </div>
  </section>

  <section class="benefits" id="features">
    <div class="wrap">
      <div class="benefits-head" data-reveal>
        <div>
          <p class="section-label">The problem</p>
          <h2 class="section-title wide">Your agents shouldn't spend their day asking the same five questions.</h2>
        </div>
      </div>

      <div class="benefits-card" data-reveal="scale" style="--reveal-i:1">
        <div class="benefits-media">
          <WarmHandoffMock />
        </div>
        <div>
          <h3>DialerBot takes care of the first conversation.</h3>
          <p class="desc" style="margin-bottom:1.25rem">
            Agents spend valuable minutes greeting prospects, repeating qualification questions, handling “I'm not
            interested,” collecting basic information, and waiting for someone who may never become a customer. That
            work has to happen — but it does not always need a human.
          </p>
          {
            benefitFeatures.map((f) => (
              <div class="benefits-feature">
                <span class="icon-mask" style={`--icon:url(${f.icon})`} />
                <div>
                  <p>{f.title}</p>
                  <p class="desc">{f.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sponsors" aria-label="How DialerBot works">
    <div class="wrap">
      <p class="section-label center" data-reveal>How it works</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">From dial to qualified conversation in seconds.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          howItWorks.map((step, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{step.n} — {step.title}</strong>
              <span>{step.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="spotlight">
    <div class="spotlight-inner">
      <p class="section-label center" data-reveal>Core value</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">One AI layer between your dialer and your agents.</h2>
      <div class="spotlight-grid">
        {
          spotlights.map((card, i) => (
            <article class="spotlight-card" data-reveal="up" data-lift style={`--reveal-i: ${i}`}>
              <img
                class="spotlight-card__media"
                src={card.image}
                alt=""
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <div />
              <div>
                <h3>{card.title}</h3>
                <a class="btn btn-outline-white" href="/features">
                  {valueProps[i]?.title || 'Explore features'}
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="aeo-solutions__grid" style="margin-top:2.5rem">
        {
          valueProps.map((v, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i}`}>
              <strong>{v.title}</strong>
              <span>{v.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="service">
    <div class="wrap">
      {
        serviceRows.map((row, i) => (
          <div class:list={['service-row', { reverse: row.reverse }]} style={`--stack-i: ${i}`}>
            <div class="service-copy">
              <p class="section-label">{row.label}</p>
              <h2>{row.title}</h2>
              <div class="service-points">
                {row.points.map((point) => (
                  <div class="icon-row">
                    <span class="icon-mask" style={`--icon:url(${point.icon})`} />
                    <p>{point.text}</p>
                  </div>
                ))}
              </div>
              <a
                class="btn btn-chip"
                href={row.mock === 'backend' ? '/features' : demo.homeChip}
                target={row.mock === 'backend' ? undefined : '_blank'}
                rel={row.mock === 'backend' ? undefined : 'noopener noreferrer'}
              >
                {row.cta}
              </a>
            </div>
            <div class="service-media">
              <FeatureConsoleMock variant={row.mock} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="success" id="company">
    <div class="wrap">
      <p class="section-label center" data-reveal>Use cases</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Built for real calling operations.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          useCases.map((u, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{u.title}</strong>
              <span>{u.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stats" id="pricing">
    <div class="wrap">
      <p class="section-label center" data-reveal>Features</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Everything you need to run an AI calling campaign.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          featuresList.map((f, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{f.title}</strong>
              <span>{f.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="testimonials">
    <div class="wrap">
      <p class="section-label center" data-reveal>Why DialerBot</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Built for call centers—not generic chatbots.</h2>
      <p class="lead center" data-reveal style="--reveal-i:2;max-width:42rem;margin-inline:auto">
        Generic voice assistants are often designed for reception desks, appointments, and simple customer service.
        Call centers need something different.
      </p>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          callCenterNeeds.map((need, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{need}</strong>
              <span>DialerBot is built around that environment.</span>
            </div>
          ))
        }
      </div>

      <div class="success-grid" style="margin-top:3rem">
        <div class="success-copy" data-reveal="left">
          <p class="section-label">Operations</p>
          <h3>Give your agents fewer calls—and better calls.</h3>
          <p class="lead">
            Your goal isn't to replace every person on your floor. Your goal is to make every agent more productive.
            DialerBot handles repetitive conversations so your team can spend more time on the calls that actually
            require human judgment.
          </p>
          <p class="lead" style="font-weight:700">
            AI handles the repetitive work. People handle the important conversations.
          </p>
          <div class="hero-actions" style="margin-top:1.5rem">
            <a class="btn btn-chip" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try the Live Demo</a>
            <a class="btn btn-chip" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Sales</a>
          </div>
        </div>
        <div class="success-media" data-reveal="right" style="--reveal-i:1">
          <FeatureConsoleMock variant="motive" />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = document.querySelectorAll('.spotlight-card');

    /** @param {Element | null} el */
    const watch = (el) => {
      if (!el || reduced) return;
      if (!('IntersectionObserver' in window)) {
        el.classList.add('is-inview');
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-inview', entry.isIntersecting);
          });
        },
        { threshold: 0.2 },
      );
      io.observe(el);
    };

    cards.forEach((card) => watch(card));
  })();
</script>
