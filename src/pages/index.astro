---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureConsoleMock from '../components/FeatureConsoleMock.astro';
import WarmHandoffMock from '../components/WarmHandoffMock.astro';
import HeroOrbitMock from '../components/HeroOrbitMock.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, demo } from '../data/site';
import { definedTermJsonLd, webPageJsonLd } from '../data/seo';
import {
  definition,
  productFlow,
  capabilities,
  dispositions,
  dispositionPlainEnglish,
  pricing,
  primaryIndustries,
} from '../data/product';
import '../styles/global.css';

export const prerender = true;

const dialerBotDefinition = definition;

const homeTitle = 'AI Voice Bot for Call Centers | DialerBot';
const homeDescription =
  'AI voice bot for call centers. Works with your existing PC dialer, detects voicemail and answering machines, qualifies leads, and live-transfers qualified calls to a human closer.';

const benefitFeatures = [
  {
    icon: '/images/dialerbot-elements.svg',
    title: 'The bot opens every call',
    text: 'It greets the customer, follows your business-specific script, and asks the qualification questions your campaign requires.',
  },
  {
    icon: '/images/dialerbot-elements-1.svg',
    title: 'Your human closer completes the sale',
    text: 'When a lead qualifies, the bot live-transfers the call to your closer, who handles the conversation, verification, paperwork, and the actual deal.',
  },
];

/** The six canonical stages, straight from product.ts. */
const howItWorks = productFlow.map((step) => ({
  n: String(step.n).padStart(2, '0'),
  title: step.name,
  text: step.plain,
}));

const valueProps = [
  {
    title: 'Stop wasting talk time',
    text: 'The bot filters out voicemail, answering machines, and automated responses before they ever reach a closer.',
  },
  {
    title: 'Keep your existing PC dialer',
    text: 'Dialer Bot is designed to integrate with the PC dialer workflow your call center already runs, instead of forcing you to replace your stack.',
  },
  {
    title: 'Live-transfer qualified leads',
    text: "Don't drop an agent into a conversation blind. A qualified, interested call is transferred live, with the context already collected.",
  },
  {
    title: 'Every call gets a disposition',
    text: `${dispositionPlainEnglish} Examples: ${dispositions.examples.map((d) => d.label).join(', ')}.`,
  },
];

const spotlights = [
  {
    image: '/images/dialerbot-home-01.webp',
    title: 'Call detection that filters out voicemail, answering machines, and honeypots',
  },
  {
    image: '/images/dialerbot-home-02.webp',
    title: 'Business-specific scripts and qualification questions that filter out bad leads',
  },
  {
    image: '/images/dialerbot-home-03.webp',
    title: 'Dispositions, recordings, and transcripts so you can see how each campaign is doing',
  },
];

const serviceRows = [
  {
    reverse: false,
    label: 'Outbound Sales',
    title: 'Let AI make the first move',
    points: [
      { icon: '/images/dialerbot-radial.svg', text: 'AI starts the call and checks if the lead is good' },
      { icon: '/images/dialerbot-target-02.svg', text: 'Interested people are transferred to your sales team' },
      { icon: '/images/dialerbot-crowdfunding.svg', text: 'Bad leads are dropped early to save time' },
      { icon: '/images/dialerbot-computer-dollar.svg', text: 'Made for teams that make a lot of calls' },
    ],
    mock: 'outbound' as const,
    cta: 'See how it works',
  },
  {
    reverse: true,
    label: 'Inbound Reception',
    title: 'Answer, ask, and transfer',
    points: [
      { icon: '/images/dialerbot-elements.svg', text: 'Answer incoming calls 24/7' },
      { icon: '/images/dialerbot-elements-2.svg', text: 'Find out exactly what the caller needs' },
      { icon: '/images/dialerbot-elements-3.svg', text: 'Send the call to the right person instantly' },
      { icon: '/images/dialerbot-analysis-text-link.svg', text: 'Never miss a call when you are busy or closed' },
    ],
    mock: 'inbound' as const,
    cta: 'See how it works',
  },
  {
    reverse: false,
    label: 'PC Dialer Setup',
    title: 'Keep the PC dialer you already run',
    points: [
      { icon: '/images/dialerbot-elements-4.svg', text: 'Designed to integrate with your existing PC dialer workflow' },
      { icon: '/images/dialerbot-discover-circle.svg', text: 'Your team does not need to learn a whole new software' },
      { icon: '/images/dialerbot-bulb-charge.svg', text: 'The bot handles the opening call, not the whole workflow' },
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Add bots as your call volume and agent count grow' },
    ],
    mock: 'dialer' as const,
    cta: 'Let\'s talk setup',
  },
  {
    reverse: true,
    label: 'Voice & Campaigns',
    title: 'A high-quality AI voice for every business',
    points: [
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'High-quality AI voice that holds a real conversation' },
      { icon: '/images/dialerbot-clock.svg', text: 'Each business or campaign can have its own script' },
      { icon: '/images/dialerbot-hourglass.svg', text: 'Voice cloning and multi-language support' },
      { icon: '/images/dialerbot-paragraph-bullets-point-01.svg', text: 'Listen to past calls to see what works best' },
    ],
    mock: 'backend' as const,
    cta: 'See all features',
  },
];

/**
 * Confirmed capabilities only, from product.ts. Calendar Scheduling and
 * native Zapier/Salesforce/HubSpot are intentionally absent.
 */
const featuresList = capabilities
  .filter((c) => c.primary)
  .map((c) => ({ title: c.name, text: c.plain }));

const useCases = primaryIndustries.map((industry) => ({
  title: industry.name,
  text: industry.note,
  href: industry.href,
}));

const callCenterNeeds = [
  'Fewer calls wasted on voicemail and answering machines',
  'Closer time spent on leads that actually qualify',
  'Scales with campaign volume without extra headcount',
  'No new training for closers — they take the same live call',
  'DNC (Do Not Call) checked before a call proceeds',
  'Every call ends with a recorded disposition',
];
---

<BaseLayout
  title={homeTitle}
  description={homeDescription}
  image="/images/dialerbot-home-01.webp"
  preloadImages={['/images/dialerbot-bg-image.webp']}
  jsonLd={[
    webPageJsonLd({
      name: homeTitle,
      description: homeDescription,
      path: '/',
    }),
    definedTermJsonLd('DialerBot', dialerBotDefinition, '/'),
  ]}
>
  <Header slot="header" />

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="announcement">
            <span class="badge">AI</span>
            <p>AI Voice Bot for Call Centers</p>
            <span class="arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <h1>Let the AI voice bot handle the first call. Your closer handles the sale.</h1>
          <p class="lead">
            Dialer Bot works with your existing PC dialer. It detects voicemail, answering machines, and honeypots, runs your business-specific script,
            checks whether the lead qualifies and is interested, then live-transfers the good ones to a human closer.<br/><br/>
            <span style="opacity:0.9;font-weight:600;">Get more good calls and stop wasting time on bad ones.</span>
          </p>
          <div class="hero-actions">
            <a class="btn btn-white" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try It Live</a>
            <a class="btn btn-glass" href={wa.start} target="_blank" rel="noopener noreferrer">
              Talk to Us
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
          <p style="margin:1rem 0 0;font-size:0.85rem;opacity:0.75;max-width:36rem;line-height:1.45">
            Built for call centers that make or take a lot of calls. Keep your existing PC dialer and let the bot handle the opening conversation.
          </p>
        </div>
        <div class="hero-visual" data-reveal="right" style="--reveal-i:0">
          <HeroOrbitMock />
        </div>
      </div>
    </div>
  </section>

  <section class="aeo-solutions wrap" aria-label="DialerBot promise">
    <p class="section-label" data-reveal>Our Promise</p>
      <h2 class="section-title" data-reveal style="--reveal-i:1">
        You find the numbers. Your PC dialer dials. The bot qualifies. Your closer closes the deal.
      </h2>
    <div data-reveal style="--reveal-i:1.5">
      <AeoDefinition term="DialerBot" definition={dialerBotDefinition} />
    </div>
    <div class="aeo-solutions__grid">
      <a class="aeo-solutions__card" href="/features" data-reveal="up" style="--reveal-i:0">
        <strong>Live transfer</strong>
        <span>Qualified, interested calls reach a human closer live, not on blind hold.</span>
      </a>
      <a class="aeo-solutions__card" href="/features" data-reveal="up" style="--reveal-i:1">
        <strong>Call detection</strong>
        <span>Voicemail, answering machines, and honeypots are filtered out before they reach a seat.</span>
      </a>
      <a class="aeo-solutions__card" href="/pricing" data-reveal="up" style="--reveal-i:2">
        <strong>Start with one bot</strong>
        <span>${pricing.reference.amount} per bot per month. Scale when your floor is ready.</span>
      </a>
    </div>
  </section>

  <section class="benefits" id="features">
    <div class="wrap">
      <div class="benefits-head" data-reveal>
        <div>
          <p class="section-label">The Problem</p>
          <h2 class="section-title wide">Your team is tired of asking the same five questions.</h2>
        </div>
      </div>

      <div class="benefits-card" data-reveal="scale" style="--reveal-i:1">
        <div class="benefits-media">
          <WarmHandoffMock />
        </div>
        <div>
          <h3>Dialer Bot takes care of the boring first call.</h3>
          <p class="desc" style="margin-bottom:1.25rem">
            Closers spend too much time saying hello, asking basic questions, and talking to people who are not interested. This work still needs doing, but a human should not have to do all of it.
          </p>
          {
            benefitFeatures.map((f) => (
              <div class="benefits-feature">
                <span class="icon-mask" style={`--icon:url(${f.icon})`} />
                <div>
                  <p>{f.title}</p>
                  <p class="desc">{f.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sponsors" aria-label="How DialerBot works">
    <div class="wrap">
      <p class="section-label center" data-reveal>How it Works</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">From dialing to a good conversation in seconds.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          howItWorks.map((step, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{step.n} — {step.title}</strong>
              <span>{step.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="spotlight">
    <div class="spotlight-inner">
      <p class="section-label center" data-reveal>Why Choose Us</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">The AI voice bot for your call-center workflow.</h2>
      <div class="spotlight-grid">
        {
          spotlights.map((card, i) => (
            <article class="spotlight-card" data-reveal="up" data-lift style={`--reveal-i: ${i}`}>
              <img
                class="spotlight-card__media"
                src={card.image}
                alt=""
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <div />
              <div>
                <h3>{card.title}</h3>
                <a class="btn btn-outline-white" href="/features">
                  {valueProps[i]?.title || 'Explore features'}
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="aeo-solutions__grid" style="margin-top:2.5rem">
        {
          valueProps.map((v, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i}`}>
              <strong>{v.title}</strong>
              <span>{v.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="service">
    <div class="wrap">
      {
        serviceRows.map((row, i) => (
          <div class:list={['service-row', { reverse: row.reverse }]} style={`--stack-i: ${i}`}>
            <div class="service-copy">
              <p class="section-label">{row.label}</p>
              <h2>{row.title}</h2>
              <div class="service-points">
                {row.points.map((point) => (
                  <div class="icon-row">
                    <span class="icon-mask" style={`--icon:url(${point.icon})`} />
                    <p>{point.text}</p>
                  </div>
                ))}
              </div>
              <a
                class="btn btn-chip"
                href={row.mock === 'backend' ? '/features' : demo.homeChip}
                target={row.mock === 'backend' ? undefined : '_blank'}
                rel={row.mock === 'backend' ? undefined : 'noopener noreferrer'}
              >
                {row.cta}
              </a>
            </div>
            <div class="service-media">
              <FeatureConsoleMock variant={row.mock} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="success" id="company">
    <div class="wrap">
      <p class="section-label center" data-reveal>Industries</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Built for call centers, restaurants, and truck dispatch.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          useCases.map((u, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{u.title}</strong>
              <span>{u.text}</span>
              {u.href && (
                <a href={u.href} style="margin-top:0.75rem;display:inline-block">
                  Learn more
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stats" id="pricing">
    <div class="wrap">
      <p class="section-label center" data-reveal>Features</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Everything you need for the first call.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          featuresList.map((f, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{f.title}</strong>
              <span>{f.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="testimonials">
    <div class="wrap">
      <p class="section-label center" data-reveal>Operational Benefits</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Why call centers add a bot to the floor.</h2>
          <p class="lead center" data-reveal style="--reveal-i:2;max-width:42rem;margin-inline:auto">
            Running a call center comes with challenges. Dialer Bot takes on the repetitive opening calls so your closers spend their time where they close.
          </p>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          callCenterNeeds.map((need, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{need}</strong>
              <span>DialerBot handles this easily.</span>
            </div>
          ))
        }
      </div>

      <div class="success-grid" style="margin-top:3rem">
        <div class="success-copy" data-reveal="left">
          <p class="section-label">Results</p>
          <h3>Give your closers better calls, not just more calls.</h3>
          <p class="lead">
            The bot is not the final salesperson. It handles the opening conversation and the qualification; your human closer completes the actual sale.
          </p>
          <p class="lead" style="font-weight:700">
            The bot handles the first part of the call. Your closer handles the deal.
          </p>
          <div class="hero-actions" style="margin-top:1.5rem">
            <a class="btn btn-chip" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try the Live Demo</a>
            <a class="btn btn-chip" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Us</a>
          </div>
        </div>
        <div class="success-media" data-reveal="right" style="--reveal-i:1">
          <FeatureConsoleMock variant="motive" />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = document.querySelectorAll('.spotlight-card');

    /** @param {Element | null} el */
    const watch = (el) => {
      if (!el || reduced) return;
      if (!('IntersectionObserver' in window)) {
        el.classList.add('is-inview');
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-inview', entry.isIntersecting);
          });
        },
        { threshold: 0.2 },
      );
      io.observe(el);
    };

    cards.forEach((card) => watch(card));
  })();
</script>
