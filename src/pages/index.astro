---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureConsoleMock from '../components/FeatureConsoleMock.astro';
import WarmHandoffMock from '../components/WarmHandoffMock.astro';
import HeroOrbitMock from '../components/HeroOrbitMock.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, demo } from '../data/site';
import { definedTermJsonLd, webPageJsonLd } from '../data/seo';
import '../styles/global.css';

export const prerender = true;

const dialerBotDefinition =
  'DialerBot is an AI assistant for call centers. It makes the first call, and your human agents only talk to the people who are interested.';

const homeTitle = 'AI Voice Assistant for Call Centers | DialerBot';
const homeDescription =
  'Automate your phone calls with AI. DialerBot talks to leads first and transfers the good ones to your team.';

const benefitFeatures = [
  {
    icon: '/images/dialerbot-elements.svg',
    title: 'AI makes the first call',
    text: 'It greets the customer, asks basic questions, and checks if they are interested. No more repetitive work for your team.',
  },
  {
    icon: '/images/dialerbot-elements-1.svg',
    title: 'Your team closes the deal',
    text: 'When a lead is ready, the AI transfers the call to your human agent along with all the details it gathered.',
  },
];

const howItWorks = [
  {
    n: '01',
    title: 'Connect your system',
    text: 'Keep using your current calling software. Just link DialerBot to it.',
  },
  {
    n: '02',
    title: 'Set up your rules',
    text: 'Tell the bot what to say, what to ask, and when to transfer a call.',
  },
  {
    n: '03',
    title: 'AI talks naturally',
    text: 'The bot sounds like a real person. It listens and responds instead of just reading a script.',
  },
  {
    n: '04',
    title: 'Find the best leads',
    text: 'The bot figures out if the person on the phone is a good fit for your business.',
  },
  {
    n: '05',
    title: 'Transfer to a human',
    text: 'Good leads get sent to your agents immediately, along with all the notes.',
  },
  {
    n: '06',
    title: 'Check the results',
    text: 'Listen to call recordings, read transcripts, and see how your campaign is doing in one place.',
  },
];

const valueProps = [
  {
    title: 'Save time on early calls',
    text: 'Let AI handle the repetitive first stage of every campaign and reduce the number of low-value conversations reaching your agents.',
  },
  {
    title: 'Keep your existing dialer',
    text: 'DialerBot is designed to work alongside the infrastructure your call center already uses instead of forcing you to replace your entire stack.',
  },
  {
    title: 'Warm-transfer qualified leads',
    text: "Don't send an agent into a conversation blind. Transfer the call with the relevant context already collected.",
  },
  {
    title: 'Run campaigns around the clock',
    text: 'Use AI for outbound campaigns, inbound reception, overflow handling, callbacks, lead qualification, and other repetitive calling workflows.',
  },
];

const spotlights = [
  {
    image: '/images/dialerbot-home-01.webp',
    title: 'Answering service that routes calls to the right person',
  },
  {
    image: '/images/dialerbot-home-02.webp',
    title: 'Calling campaigns that filter out bad leads automatically',
  },
  {
    image: '/images/dialerbot-home-03.webp',
    title: 'Listen to recordings and see how your campaigns are doing',
  },
];

const serviceRows = [
  {
    reverse: false,
    label: 'Outbound Sales',
    title: 'Let AI make the first move',
    points: [
      { icon: '/images/dialerbot-radial.svg', text: 'AI starts the call and checks if the lead is good' },
      { icon: '/images/dialerbot-target-02.svg', text: 'Interested people are transferred to your sales team' },
      { icon: '/images/dialerbot-crowdfunding.svg', text: 'Bad leads are dropped early to save time' },
      { icon: '/images/dialerbot-computer-dollar.svg', text: 'Made for teams that make a lot of calls' },
    ],
    mock: 'outbound' as const,
    cta: 'See how it works',
  },
  {
    reverse: true,
    label: 'Inbound Reception',
    title: 'Answer, ask, and transfer',
    points: [
      { icon: '/images/dialerbot-elements.svg', text: 'Answer incoming calls 24/7' },
      { icon: '/images/dialerbot-elements-2.svg', text: 'Find out exactly what the caller needs' },
      { icon: '/images/dialerbot-elements-3.svg', text: 'Send the call to the right person instantly' },
      { icon: '/images/dialerbot-analysis-text-link.svg', text: 'Never miss a call when you are busy or closed' },
    ],
    mock: 'inbound' as const,
    cta: 'See how it works',
  },
  {
    reverse: false,
    label: 'Easy Setup',
    title: 'Keep using your favorite tools',
    points: [
      { icon: '/images/dialerbot-elements-4.svg', text: 'Works with your current dialer or calling system' },
      { icon: '/images/dialerbot-discover-circle.svg', text: 'Your team does not need to learn a whole new software' },
      { icon: '/images/dialerbot-bulb-charge.svg', text: 'AI acts like a helper, not a replacement for your tools' },
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Grow your business without changing how you work' },
    ],
    mock: 'dialer' as const,
    cta: 'Let\'s talk setup',
  },
  {
    reverse: true,
    label: 'Manage Campaigns',
    title: 'Everything in one simple dashboard',
    points: [
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Make AI sound natural instead of like a robot' },
      { icon: '/images/dialerbot-clock.svg', text: 'Set up different rules for different campaigns' },
      { icon: '/images/dialerbot-hourglass.svg', text: 'Listen to past calls to see what works best' },
      { icon: '/images/dialerbot-paragraph-bullets-point-01.svg', text: 'Watch your campaign results live' },
    ],
    mock: 'backend' as const,
    cta: 'See all features',
  },
];

const featuresList = [
  { title: 'Natural AI Conversations', text: 'Give people a real conversation, not a robotic menu.' },
  { title: 'Custom Scripts', text: 'Create different questions and rules for every campaign you run.' },
  { title: 'Smart Lead Scoring', text: 'The AI knows if a lead is good before passing it to your agents.' },
  { title: 'Smooth Transfers', text: 'Send good calls to your agents right away with all the details.' },
  { title: 'Call Recordings', text: 'Listen to previous calls and read text versions to improve.' },
  { title: 'Easy Integration', text: 'Connect DialerBot with the calling tools you already use.' },
  { title: 'Live Tracking', text: 'See exactly what is happening with your calls right now.' },
  { title: 'CRM Connection', text: 'Send all gathered info straight to your customer database.' },
];

const useCases = [
  { title: 'Sales Calls', text: 'Let AI make the first contact, find interested people, and transfer them to your sales team.' },
  { title: 'Sorting Leads', text: 'Ask the same questions on every call and send the answers to your agents automatically.' },
  { title: 'Answering Service', text: 'Answer incoming calls, figure out what the person wants, and send them to the right place.' },
  { title: 'Insurance', text: 'Easily set up questions to qualify people for insurance or other services.' },
  { title: 'Support & Dispatch', text: 'Answer basic questions and gather info before sending the call to a support agent.' },
  { title: 'Custom Needs', text: 'Tell the AI exactly what to say and ask for your unique business.' },
];

const callCenterNeeds = [
  'Handling lots of calls',
  'Custom rules for campaigns',
  'Sorting out good leads',
  'Quick call transfers',
  'Tracking call results',
  'Making agents faster',
  'Using existing tools',
];
---

<BaseLayout
  title={homeTitle}
  description={homeDescription}
  image="/images/dialerbot-home-01.webp"
  preloadImages={['/images/dialerbot-bg-image.webp']}
  jsonLd={[
    webPageJsonLd({
      name: homeTitle,
      description: homeDescription,
      path: '/',
    }),
    definedTermJsonLd('DialerBot', dialerBotDefinition, '/'),
  ]}
>
  <Header slot="header" />

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="announcement">
            <span class="badge">AI</span>
            <p>AI Voice Agents for Call Centers</p>
            <span class="arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <h1>Let AI handle the first conversation. Your team handles the close.</h1>
          <p class="lead">
            DialerBot works with your current tools to answer calls, speak naturally, ask questions, and transfer only the best leads to your human agents.
          </p>
          <p class="lead" style="opacity:0.9;margin-top:0.75rem;font-weight:600">
            Get more good calls and stop wasting time on bad ones.
          </p>
          <div class="hero-actions">
            <a class="btn btn-white" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try It Live</a>
            <a class="btn btn-glass" href={wa.start} target="_blank" rel="noopener noreferrer">
              Talk to Us
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
          <p style="margin:1rem 0 0;font-size:0.85rem;opacity:0.75;max-width:36rem;line-height:1.45">
            Perfect for teams making or taking lots of calls. Connect your system and let the AI do the heavy lifting.
          </p>
        </div>
        <div class="hero-visual" data-reveal="right" style="--reveal-i:0">
          <HeroOrbitMock />
        </div>
      </div>
    </div>
  </section>

  <section class="aeo-solutions wrap" aria-label="DialerBot promise">
    <p class="section-label" data-reveal>Our Promise</p>
    <h2 class="section-title" data-reveal style="--reveal-i:1">
      You find the numbers. DialerBot makes the call. Your agents close the deal.
    </h2>
    <div data-reveal style="--reveal-i:1.5">
      <AeoDefinition term="DialerBot" definition={dialerBotDefinition} />
    </div>
    <div class="aeo-solutions__grid">
      <a class="aeo-solutions__card" href="/solutions/warm-handoff" data-reveal="up" style="--reveal-i:0">
        <strong>Warm transfer</strong>
        <span>Qualified conversations reach agents with context — not cold dumps.</span>
      </a>
      <a class="aeo-solutions__card" href="/features" data-reveal="up" style="--reveal-i:1">
        <strong>Campaign control</strong>
        <span>Scripts, qualification rules, monitoring, and recordings in one platform.</span>
      </a>
      <a class="aeo-solutions__card" href="/pricing" data-reveal="up" style="--reveal-i:2">
        <strong>Start with one bot</strong>
        <span>From $35 per bot. Scale when your floor is ready.</span>
      </a>
    </div>
  </section>

  <section class="benefits" id="features">
    <div class="wrap">
      <div class="benefits-head" data-reveal>
        <div>
          <p class="section-label">The Problem</p>
          <h2 class="section-title wide">Your team is tired of asking the same five questions.</h2>
        </div>
      </div>

      <div class="benefits-card" data-reveal="scale" style="--reveal-i:1">
        <div class="benefits-media">
          <WarmHandoffMock />
        </div>
        <div>
          <h3>DialerBot takes care of the boring stuff.</h3>
          <p class="desc" style="margin-bottom:1.25rem">
            Agents spend too much time saying hello, asking basic questions, and dealing with people who aren't interested. This works needs to be done, but a human shouldn't have to do it.
          </p>
          {
            benefitFeatures.map((f) => (
              <div class="benefits-feature">
                <span class="icon-mask" style={`--icon:url(${f.icon})`} />
                <div>
                  <p>{f.title}</p>
                  <p class="desc">{f.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sponsors" aria-label="How DialerBot works">
    <div class="wrap">
      <p class="section-label center" data-reveal>How it Works</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">From dialing to a good conversation in seconds.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          howItWorks.map((step, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{step.n} — {step.title}</strong>
              <span>{step.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="spotlight">
    <div class="spotlight-inner">
      <p class="section-label center" data-reveal>Why Choose Us</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">The smart AI assistant for your team.</h2>
      <div class="spotlight-grid">
        {
          spotlights.map((card, i) => (
            <article class="spotlight-card" data-reveal="up" data-lift style={`--reveal-i: ${i}`}>
              <img
                class="spotlight-card__media"
                src={card.image}
                alt=""
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <div />
              <div>
                <h3>{card.title}</h3>
                <a class="btn btn-outline-white" href="/features">
                  {valueProps[i]?.title || 'Explore features'}
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="aeo-solutions__grid" style="margin-top:2.5rem">
        {
          valueProps.map((v, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i}`}>
              <strong>{v.title}</strong>
              <span>{v.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="service">
    <div class="wrap">
      {
        serviceRows.map((row, i) => (
          <div class:list={['service-row', { reverse: row.reverse }]} style={`--stack-i: ${i}`}>
            <div class="service-copy">
              <p class="section-label">{row.label}</p>
              <h2>{row.title}</h2>
              <div class="service-points">
                {row.points.map((point) => (
                  <div class="icon-row">
                    <span class="icon-mask" style={`--icon:url(${point.icon})`} />
                    <p>{point.text}</p>
                  </div>
                ))}
              </div>
              <a
                class="btn btn-chip"
                href={row.mock === 'backend' ? '/features' : demo.homeChip}
                target={row.mock === 'backend' ? undefined : '_blank'}
                rel={row.mock === 'backend' ? undefined : 'noopener noreferrer'}
              >
                {row.cta}
              </a>
            </div>
            <div class="service-media">
              <FeatureConsoleMock variant={row.mock} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="success" id="company">
    <div class="wrap">
      <p class="section-label center" data-reveal>What We Do</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Built for real phone teams.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          useCases.map((u, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{u.title}</strong>
              <span>{u.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="stats" id="pricing">
    <div class="wrap">
      <p class="section-label center" data-reveal>Features</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Everything you need for smart calling.</h2>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          featuresList.map((f, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{f.title}</strong>
              <span>{f.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="testimonials">
    <div class="wrap">
      <p class="section-label center" data-reveal>Why DialerBot</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Made for businesses, not just a basic bot.</h2>
      <p class="lead center" data-reveal style="--reveal-i:2;max-width:42rem;margin-inline:auto">
        Regular voice bots are okay for simple tasks. But if your team makes hundreds of calls, you need something stronger.
      </p>
      <div class="aeo-solutions__grid" style="margin-top:2rem">
        {
          callCenterNeeds.map((need, i) => (
            <div class="aeo-solutions__card" data-reveal="up" style={`--reveal-i: ${i % 3}`}>
              <strong>{need}</strong>
              <span>DialerBot handles this easily.</span>
            </div>
          ))
        }
      </div>

      <div class="success-grid" style="margin-top:3rem">
        <div class="success-copy" data-reveal="left">
          <p class="section-label">Results</p>
          <h3>Give your team better calls, not just more calls.</h3>
          <p class="lead">
            The goal isn't to replace your staff. It's to help them succeed. DialerBot does the boring work so your team can focus on the calls that actually matter.
          </p>
          <p class="lead" style="font-weight:700">
            AI handles the boring parts. Your team handles the real conversations.
          </p>
          <div class="hero-actions" style="margin-top:1.5rem">
            <a class="btn btn-chip" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try the Live Demo</a>
            <a class="btn btn-chip" href={wa.start} target="_blank" rel="noopener noreferrer">Talk to Us</a>
          </div>
        </div>
        <div class="success-media" data-reveal="right" style="--reveal-i:1">
          <FeatureConsoleMock variant="motive" />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = document.querySelectorAll('.spotlight-card');

    /** @param {Element | null} el */
    const watch = (el) => {
      if (!el || reduced) return;
      if (!('IntersectionObserver' in window)) {
        el.classList.add('is-inview');
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('is-inview', entry.isIntersecting);
          });
        },
        { threshold: 0.2 },
      );
      io.observe(el);
    };

    cards.forEach((card) => watch(card));
  })();
</script>
