---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureConsoleMock from '../components/FeatureConsoleMock.astro';
import WarmHandoffMock from '../components/WarmHandoffMock.astro';
import HeroOrbitMock from '../components/HeroOrbitMock.astro';
import AeoDefinition from '../components/AeoDefinition.astro';
import { wa, demo } from '../data/site';
import { definedTermJsonLd, webPageJsonLd } from '../data/seo';
import '../styles/global.css';

export const prerender = true;

const dialerBotDefinition =
  'Dialer Bot is an AI voice bot platform that qualifies inbound and outbound calls for call centers, truck dispatch, ACA, FE, and HI — then warm-handoffs only closable leads to human agents with context.';

const benefitFeatures = [
  {
    icon: '/images/dialerbot-elements.svg',
    title: 'Qualify Calls Before Agents Pick Up',
    text: 'Dialer Bot asks the first round of questions on every inbound and outbound call, so your team only spends time on leads that are ready to talk.',
  },
  {
    icon: '/images/dialerbot-elements-1.svg',
    title: 'Stay in Sync With Your Dialer',
    text: 'The bot matches the pace of your dialer in real time. When volume spikes, it keeps up. When the queue slows, it does too — no wasted seats, no stalled campaigns.',
  },
];

const sponsors = [
  { src: '/images/sponsor-northlane.svg', name: 'Northlane', tip: 'Truck dispatch floor' },
  { src: '/images/sponsor-harboraca.svg', name: 'HarborACA', tip: 'ACA outbound floor' },
  { src: '/images/sponsor-summitfe.svg', name: 'SummitFE', tip: 'Final Expense sales' },
  { src: '/images/sponsor-clearline.svg', name: 'Clearline', tip: 'Inbound reception' },
  { src: '/images/sponsor-peakfloor.svg', name: 'PeakFloor', tip: 'Health Insurance dialing' },
  { src: '/images/sponsor-relayops.svg', name: 'RelayOps', tip: 'Broker dispatch desk' },
];

const sponsorRails = [
  { key: 'a', items: [...sponsors, ...sponsors, ...sponsors] },
  { key: 'b', items: [...sponsors].reverse().concat([...sponsors].reverse(), [...sponsors].reverse()) },
];

const spotlights = [
  {
    image: '/images/dialerbot-home-01.webp',
    title: 'Inbound receptionist,  never misses a call',
  },
  {
    image: '/images/dialerbot-home-02.webp',
    title: 'Outbound bots ready for ACA, FE, HI & more',
  },
  {
    image: '/images/dialerbot-home-03.webp',
    title: 'Live logs, recordings, and call monitoring',
  },
];

const serviceRows = [
  {
    reverse: false,
    label: 'Inbound Voice Bots',
    title: 'A digital receptionist that qualifies every caller',
    points: [
      { icon: '/images/dialerbot-elements.svg', text: 'Answer and greet callers around the clock' },
      { icon: '/images/dialerbot-elements-2.svg', text: 'Ask scripted intake questions with natural replies' },
      { icon: '/images/dialerbot-elements-3.svg', text: 'Route warm leads straight to the right agent' },
      { icon: '/images/dialerbot-analysis-text-link.svg', text: 'Cut hold times and empty agent hours' },
    ],
    mock: 'inbound' as const,
    cta: 'See inbound qualification',
  },
  {
    reverse: true,
    label: 'Outbound Campaigns',
    title: 'Ready-to-go bots for every call-center campaign',
    points: [
      { icon: '/images/dialerbot-radial.svg', text: 'ACA, FE, HI, and custom campaign scripts' },
      { icon: '/images/dialerbot-target-02.svg', text: 'Fine-tuned responses that feel human, not robotic' },
      { icon: '/images/dialerbot-crowdfunding.svg', text: 'Filter tire-kickers before agents dial back' },
      { icon: '/images/dialerbot-computer-dollar.svg', text: 'Built for truck dispatch, insurance, and sales floors' },
    ],
    mock: 'outbound' as const,
    cta: 'Explore campaign bots',
  },
  {
    reverse: false,
    label: 'Dialer Integration',
    title: 'Plugs into your dialer and matches its pace',
    points: [
      { icon: '/images/dialerbot-elements-4.svg', text: 'Connects with the dialers call centers already run' },
      { icon: '/images/dialerbot-discover-circle.svg', text: 'Self-paced — adjusts to live dialer speed' },
      { icon: '/images/dialerbot-bulb-charge.svg', text: 'Handles first contact so agents focus on closers' },
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Scales across seats without adding headcount' },
    ],
    mock: 'dialer' as const,
    cta: 'Learn about dialer sync',
  },
  {
    reverse: true,
    label: 'Voice, LLM & Backend',
    title: 'Humanized voices, modern models, custom control',
    points: [
      { icon: '/images/dialerbot-cloud-upload.svg', text: 'Humanized voices from speakers around the world' },
      { icon: '/images/dialerbot-clock.svg', text: 'Advanced LLMs for understanding and replies' },
      { icon: '/images/dialerbot-hourglass.svg', text: 'Custom backend for recording, logs, and monitoring' },
      { icon: '/images/dialerbot-paragraph-bullets-point-01.svg', text: 'Hardcoded first questions with fine-tuned follow-ups' },
    ],
    mock: 'backend' as const,
    cta: 'See how Dialer Bot works',
  },
];

const successPoints = [
  {
    icon: '/images/dialerbot-icon.png',
    title: 'Fewer Seats, Same Throughput',
    text: 'Let the bot clear the first few questions so your agents spend their day on conversations that convert.',
  },
  {
    icon: '/images/dialerbot-icon-1.png',
    title: 'Built for Calling Floors',
    text: 'Whether you run ACA, final expense, health insurance, truck dispatch, or general inbound — Dialer Bot fits the workflow you already have.',
  },
];

const testimonials = [
  {
    name: 'Marcus Hale',
    role: 'Call center operations lead',
    image: '/images/dialerbot-pricing-01.webp',
    quote:
      'Dialer Bot takes the first pass on every outbound dial. Our agents only jump in when someone is actually qualified. We cut wasted talk time almost overnight.',
  },
  {
    name: 'Priya Nandakumar',
    role: 'Insurance campaign manager',
    image: '/images/dialerbot-pricing-02.webp',
    quote:
      'We run ACA and FE side by side. Having ready campaign bots with fine-tuned replies meant we did not rebuild scripts from scratch for each vertical.',
  },
  {
    name: 'Derek Ortiz',
    role: 'Fleet dispatch supervisor',
    image: '/images/dialerbot-pricing-03.webp',
    quote:
      'Inbound used to pile up on our dispatch line. The receptionist bot asks the basics, logs the call, and only routes what needs a human. Drivers get answers faster.',
  },
  {
    name: 'Angela Brooks',
    role: 'Health insurance sales director',
    image: '/images/dialerbot-pricing-04.webp',
    quote:
      'The voices sound natural enough that prospects stay on the line. Pair that with dialer pacing and our HI campaigns finally stopped burning agent hours on dead air.',
  },
  {
    name: 'Jamal Reeves',
    role: 'Outbound floor manager',
    image: '/images/dialerbot-pricing-05.webp',
    quote:
      'Recordings, logs, and live monitoring live in one place. When compliance asks what was said, we pull it in seconds instead of digging through three tools.',
  },
  {
    name: 'Sofia Martins',
    role: 'Contact center owner',
    image: '/images/dialerbot-pricing-06.webp',
    quote:
      'We were hiring just to cover qualification. Dialer Bot handles that layer now. Same dialer, fewer seats, and agents who are less burned out at the end of the day.',
  },
];
---

<BaseLayout
  title="Dialer Bot | AI Voice Bots for Inbound & Outbound Calling"
  description="AI voice bots that qualify inbound and outbound calls for call centers, truck dispatch, ACA, FE, and HI — then warm-handoff closable leads to your agents."
  image="/images/dialerbot-home-01.webp"
  jsonLd={[
    webPageJsonLd({
      name: 'Dialer Bot | AI Voice Bots for Inbound & Outbound Calling',
      description:
        'AI voice bots that qualify inbound and outbound calls for call centers, truck dispatch, ACA, FE, and HI — then warm-handoff closable leads to your agents.',
      path: '/',
    }),
    definedTermJsonLd('Dialer Bot', dialerBotDefinition, '/'),
  ]}
>
  <Header slot="header" />

  <!-- a1-hero-banner -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="announcement" data-reveal style="--reveal-i:0">
            <span class="badge">NEW</span>
            <p>AI Voice Bots for Modern Dialing Floors</p>
            <span class="arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <h1 data-reveal style="--reveal-i:1">Dialer Bot qualifies the call so your agents don't have to</h1>
          <p class="lead" data-reveal style="--reveal-i:2">
            AI voice bots for inbound reception and outbound campaigns. Dialer Bot asks the first questions,
            fine-tunes the replies, and only hands off leads worth an agent’s time — for call centers, truck
            dispatch, ACA, FE, HI, and every floor that still dials by hand.
          </p>
          <div class="hero-actions" data-reveal style="--reveal-i:3">
            <a class="btn btn-white" href={demo.homeHero} target="_blank" rel="noopener noreferrer">Try Live Demo</a>
            <a class="btn btn-glass" href={wa.start} target="_blank" rel="noopener noreferrer">
              WhatsApp Sales
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="hero-visual" data-reveal="right" style="--reveal-i:2">
          <HeroOrbitMock />
        </div>
      </div>
    </div>
  </section>

  <section class="aeo-solutions wrap" aria-label="Dialer Bot solutions">
    <p class="section-label" data-reveal>Answer-ready solutions</p>
    <h2 class="section-title" data-reveal style="--reveal-i:1">Built for the floors people search for</h2>
    <div data-reveal style="--reveal-i:1.5">
      <AeoDefinition term="Dialer Bot" definition={dialerBotDefinition} />
    </div>
    <div class="aeo-solutions__grid">
      <a class="aeo-solutions__card" href="/solutions/aca-voice-bot" data-reveal="up" style="--reveal-i:0">
        <strong>ACA voice bot</strong>
        <span>Compliant openers, scored intent, warm handoff for ACA / FE / HI.</span>
      </a>
      <a class="aeo-solutions__card" href="/solutions/truck-dispatch-bot" data-reveal="up" style="--reveal-i:1">
        <strong>Truck dispatch bot</strong>
        <span>First logistics questions answered before a dispatcher joins.</span>
      </a>
      <a class="aeo-solutions__card" href="/solutions/warm-handoff" data-reveal="up" style="--reveal-i:2">
        <strong>Warm handoff</strong>
        <span>Context-rich transfers instead of cold dumps into seats.</span>
      </a>
    </div>
  </section>

  <!-- benifits -->
  <section class="benefits" id="features">
    <div class="wrap">
      <div class="benefits-head" data-reveal>
        <div>
          <p class="section-label">Built for Calling Teams</p>
          <h2 class="section-title wide">What Dialer Bot takes off your agents’ plates</h2>
        </div>
      </div>

      <div class="benefits-card" data-reveal="scale" style="--reveal-i:1">
        <div class="benefits-media">
          <WarmHandoffMock />
        </div>
        <div>
          <h3>First-contact qualification that saves seats, time, and budget</h3>
          {
            benefitFeatures.map((f) => (
              <div class="benefits-feature">
                <span class="icon-mask" style={`--icon:url(${f.icon})`} />
                <div>
                  <p>{f.title}</p>
                  <p class="desc">{f.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- sponsors-section -->
  <section class="sponsors" aria-label="Demo dialing floors">
    <div class="wrap">
      <p class="section-label center" data-reveal>Demo floors</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Built for dialing floors like these</h2>
    </div>

    <div class="sponsors-bash" data-reveal style="--reveal-i:2">
      <div class="sponsors-bash__glow" aria-hidden="true"></div>
      <div class="sponsors-bash__stage">
        {
          sponsorRails.map((rail) => (
            <div class:list={['sponsors-bash__rail', `sponsors-bash__rail--${rail.key}`]}>
              <div class="sponsors-bash__track">
                {rail.items.map((sponsor, i) => (
                  <div
                    class="sponsors-bash__chip"
                    style={`--chip-i: ${i % sponsors.length}`}
                    title={sponsor.tip}
                  >
                    <img
                      src={sponsor.src}
                      alt={i < sponsors.length ? `${sponsor.name} — ${sponsor.tip}` : ''}
                      aria-hidden={i >= sponsors.length ? 'true' : undefined}
                      loading={i < 6 ? 'eager' : 'lazy'}
                      decoding="async"
                      width="168"
                      height="36"
                    />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- feature-spotlight-grid -->
  <section class="spotlight">
    <div class="spotlight-inner">
      <p class="section-label center" data-reveal>Where Dialer Bot Fits</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">One platform for the calls your team used to handle by hand.</h2>
      <div class="spotlight-grid">
        {
          spotlights.map((card, i) => (
            <article
              class="spotlight-card"
              data-reveal="up"
              data-lift
              style={`background-image:url(${card.image}); --reveal-i: ${i}`}
            >
              <div />
              <div>
                <h3>{card.title}</h3>
                <a class="btn btn-outline-white" href="/features">
                  Learn More
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- service-section — sticky stack already handles motion; no reveal here -->
  <section class="service">
    <div class="wrap">
      {
        serviceRows.map((row, i) => (
          <div class:list={['service-row', { reverse: row.reverse }]} style={`--stack-i: ${i}`}>
            <div class="service-copy">
              <p class="section-label">{row.label}</p>
              <h2>{row.title}</h2>
              <div class="service-points">
                {row.points.map((point) => (
                  <div class="icon-row">
                    <span class="icon-mask" style={`--icon:url(${point.icon})`} />
                    <p>{point.text}</p>
                  </div>
                ))}
              </div>
              <a class="btn btn-chip" href={demo.homeChip} target="_blank" rel="noopener noreferrer">
                {row.cta}
              </a>
            </div>
            <div class="service-media">
              <FeatureConsoleMock variant={row.mock} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- success-section -->
  <section class="success" id="company">
    <div class="wrap">
      <p class="section-label center" data-reveal>Why Dialer Bot</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">Less manual calling. More conversations that matter.</h2>

      <div class="success-grid">
        <div class="success-copy" data-reveal="left">
          <p class="section-label">Our Motive</p>
          <h2>Stop burning people on the first five minutes</h2>
          <p class="lead">
            Across call centers, truck dispatch desks, insurance campaigns, and reception lines, the same work
            repeats: ask a few questions, log the answers, decide if a human should stay on the line. Dialer Bot
            owns that layer — with humanized voices, advanced language models, and a custom backend for recording,
            logs, and monitoring — so your people can focus on closing, solving, and dispatching.
          </p>
          <div class="success-points">
            {
              successPoints.map((point) => (
                <div>
                  <img src={point.icon} alt="" loading="lazy" decoding="async" width="24" height="24" />
                  <h3>{point.title}</h3>
                  <p>{point.text}</p>
                </div>
              ))
            }
          </div>
        </div>
        <div class="success-media" data-reveal="right" style="--reveal-i:1">
          <FeatureConsoleMock variant="motive" />
        </div>
      </div>
    </div>
  </section>

  <!-- a3-statistics -->
  <section class="stats" id="pricing">
    <div class="wrap">
      <p class="section-label center" data-reveal>Results on the Floor</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">What teams see when Dialer Bot takes the first pass</h2>

      <div class="stats-top">
        <div class="stat-media" data-reveal="left">
          <img
            src="/images/dialerbot-home-04.webp"
            alt="Dialer Bot reducing agent workload"
            loading="lazy"
            decoding="async"
            width="720"
            height="480"
          />
        </div>
        <div class="stat-card" data-reveal="right" data-lift style="--reveal-i:1">
          <div class="num">60%</div>
          <h3>Less agent time on raw qualification</h3>
          <p>
            Hardcoded opening questions and fine-tuned follow-ups clear the noise before a live agent ever picks up
            the call.
          </p>
        </div>
      </div>

      <div class="stats-bottom">
        <div class="stat-card" data-reveal="up" data-lift>
          <div class="num">24/7</div>
          <h3>Inbound coverage without extra seats</h3>
          <p>
            Reception bots answer, qualify, and route around the clock — so after-hours callers and overflow queues
            stop falling through.
          </p>
        </div>
        <div class="stat-media" data-reveal="scale" style="--reveal-i:1">
          <img
            src="/images/dialerbot-home-05.webp"
            alt="Dialer Bot campaign performance"
            loading="lazy"
            decoding="async"
            width="720"
            height="480"
          />
        </div>
        <div class="stat-card" data-reveal="up" data-lift style="--reveal-i:2">
          <div class="num">1:1</div>
          <h3>Pace matched to your dialer</h3>
          <p>
            Self-paced sync keeps the bot moving with live dialer speed. No backlog when you ramp, no idle bots when
            you ease off.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- testimonials -->
  <section class="testimonials">
    <div class="wrap">
      <p class="section-label center" data-reveal>From Floors That Dial Every Day</p>
      <h2 class="section-title center" data-reveal style="--reveal-i:1">What operators say after Dialer Bot goes live</h2>
      <div class="testimonial-grid">
        {
          testimonials.map((t, i) => (
            <article class="testimonial" data-reveal="up" data-lift style={`--reveal-i: ${i % 3}`}>
              <div class="testimonial-head">
                <img src={t.image} alt={t.name} loading="lazy" decoding="async" width="56" height="56" />
                <div>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </div>
              </div>
              <p>{t.quote}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
