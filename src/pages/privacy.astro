---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { site, wa } from '../data/site';
import '../styles/global.css';
import '../styles/legal-page.css';

const updated = 'August 2, 2026';

const sections = [
  {
    id: 'who',
    n: '01',
    title: 'Who we are',
    body: `Dialer Bot operates ${site.domain} and related voice-bot services from ${site.address.line1}, ${site.address.line2}, ${site.address.city}. Contact: ${site.email} · WhatsApp ${site.phoneDisplay}.`,
  },
  {
    id: 'collect',
    n: '02',
    title: 'What we collect',
    bullets: [
      'Contact details you send via WhatsApp, email, or the website form.',
      'Operational call data for customers under contract — recordings, transcripts, dispositions, dialer metadata as configured.',
      'Basic technical logs needed to keep the site secure.',
    ],
  },
  {
    id: 'use',
    n: '03',
    title: 'How we use information',
    bullets: [
      'To respond to sales, support, and career inquiries.',
      'To deliver and improve bot qualification for paying customers.',
      'To secure systems and meet legal obligations.',
    ],
  },
  {
    id: 'sharing',
    n: '04',
    title: 'Sharing',
    body: 'We do not sell personal information. Infrastructure providers may process data to operate the service. Customer call data follows the customer’s instructions and applicable law.',
  },
  {
    id: 'retention',
    n: '05',
    title: 'Retention & choices',
    body: `Inquiry messages are kept as long as needed to help you. Call vault retention follows the floor agreement. Prefer WhatsApp or email instead of the form. Data requests: ${site.email}.`,
  },
];
---

<BaseLayout
  title="Privacy Policy | Dialer Bot"
  description={`Privacy Policy for Dialer Bot (${site.domain}). Updated ${updated}.`}
>
  <Header slot="header" />

  <main class="lg">
    <header class="lg-mast page-mast page-mast--compact" data-mast>
      <PageMastFx compact />
      <div class="lg-shell">
        <div class="lg-mast__top">
          <nav class="lg-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Privacy</span>
          </nav>
          <p class="lg-brand">Dialer Bot</p>
        </div>

        <div class="lg-mast__title">
          <h1>Privacy Policy</h1>
          <p class="lg-deck">
            How we handle contact inquiries and customer call data — plain language, not fine print alone.
          </p>
        </div>

        <dl class="lg-meta">
          <div>
            <dt>Updated</dt>
            <dd>{updated}</dd>
          </div>
          <div>
            <dt>Operator</dt>
            <dd>{site.domain}</dd>
          </div>
          <div>
            <dt>Contact</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd>
              <a href={wa.support} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="lg-section">
      <div class="lg-shell lg-layout">
        <nav class="lg-toc" aria-label="On this page">
          <p class="lg-toc__label">On this page</p>
          <ol>
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-lg-link={s.id}>
                    <span>{s.n}</span>
                    {s.title}
                  </a>
                </li>
              ))
            }
          </ol>
          <a class="lg-toc__wa" href={wa.support} target="_blank" rel="noopener noreferrer">
            Privacy question on WhatsApp
          </a>
        </nav>

        <article class="lg-body">
          {
            sections.map((s) => (
              <section class="lg-block" id={s.id} data-lg-block={s.id}>
                <header>
                  <span>{s.n}</span>
                  <h2>{s.title}</h2>
                </header>
                {s.body && <p>{s.body}</p>}
                {s.bullets && (
                  <ul>
                    {s.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </article>
      </div>
    </section>

  </main>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lg-link]'));
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-lg-block]'));

  const setActive = (id: string) => {
    links.forEach((link) => {
      link.classList.toggle('is-active', link.dataset.lgLink === id);
    });
  };

  if ('IntersectionObserver' in window && blocks.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement && visible.target.dataset.lgBlock) {
          setActive(visible.target.dataset.lgBlock);
        }
      },
      { rootMargin: '-20% 0px -55% 0px', threshold: [0.1, 0.4, 0.7] },
    );
    blocks.forEach((b) => io.observe(b));
  }

  setActive(blocks[0]?.dataset.lgBlock || 'who');
</script>
