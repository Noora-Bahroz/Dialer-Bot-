---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/contact-page.css';

export const prerender = true;

const channels = [
  {
    n: '01',
    title: 'WhatsApp',
    text: 'Primary line to the builders. Fastest for bots, quotes, and floor questions.',
    href: wa.general,
    cta: 'Open WhatsApp',
    external: true,
    primary: true,
  },
  {
    n: '02',
    title: 'Email',
    text: 'Briefs, contracts, and attachments when a thread needs a paper trail.',
    href: `mailto:${site.email}`,
    cta: site.email,
    external: false,
    primary: false,
  },
  {
    n: '03',
    title: 'Office',
    text: `${site.address.line1}, ${site.address.line2}, ${site.address.city}.`,
    href: wa.general,
    cta: 'Message before you visit',
    external: true,
    primary: false,
  },
];

const reasons = [
  'New bot or campaign pack',
  'Enterprise / multi-bot quote',
  'Dialer integration help',
  'Careers or partnership',
  'Something else',
];
---

<BaseLayout
  title="Contact | Dialer Bot"
  description={`Contact Dialer Bot — WhatsApp ${site.phoneDisplay}, ${site.email}. Office 12, Pakistan Town Phase 2, Islamabad.`}
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' },
  ])}
>
  <Header slot="header" />

  <div class="ct">
    <header class="ct-mast page-mast" data-mast>
      <PageMastFx />
      <div class="ct-shell ct-mast__grid">
        <div class="ct-mast__copy">
          <nav class="ct-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Contact</span>
          </nav>
          <p class="ct-brand">Dialer Bot</p>
          <h1>WhatsApp first. Office when you are nearby.</h1>
          <p class="ct-deck">
            Reach the people who ship the bots — not a ticket queue. Use WhatsApp for speed, email for briefs, or
            visit Office 12 in Pakistan Town Phase 2, Islamabad.
          </p>
          <div class="ct-actions">
            <a class="ct-btn ct-btn--solid" href={demo.contact} target="_blank" rel="noopener noreferrer">
              Open live demo
            </a>
            <a class="ct-btn ct-btn--ghost" href={wa.general} target="_blank" rel="noopener noreferrer">WhatsApp sales</a>
          </div>
        </div>

        <aside class="ct-mast__aside" aria-label="How to reach us">
          <div class="ct-reach" data-ct-reach data-channel="whatsapp">
            <div class="ct-reach__tabs" role="tablist" aria-label="Contact channel">
              <button
                type="button"
                class="ct-reach__tab is-active"
                role="tab"
                aria-selected="true"
                data-channel-tab="whatsapp"
                id="ct-tab-wa"
              >
                WhatsApp
              </button>
              <button
                type="button"
                class="ct-reach__tab"
                role="tab"
                aria-selected="false"
                data-channel-tab="email"
                id="ct-tab-email"
                tabindex="-1"
              >
                Email
              </button>
              <button
                type="button"
                class="ct-reach__tab"
                role="tab"
                aria-selected="false"
                data-channel-tab="office"
                id="ct-tab-office"
                tabindex="-1"
              >
                Visit
              </button>
            </div>

            <div
              class="ct-reach__panel is-active"
              role="tabpanel"
              data-channel-panel="whatsapp"
              aria-labelledby="ct-tab-wa"
            >
              <p class="ct-reach__kicker">Fastest reply</p>
              <p class="ct-reach__value">
                <a href={wa.general} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
              </p>
              <p class="ct-reach__note">Bots, quotes, dialer help — message the builders directly.</p>
              <ul class="ct-reach__tips">
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M4 19V7.5A2.5 2.5 0 0 1 6.5 5H10v14H6.5A2.5 2.5 0 0 1 4 16.5V19Zm10-14h3.5A2.5 2.5 0 0 1 20 7.5V19h-6V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  Dialer type and seat count
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M8 5h8v14H8V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M10 9h4M10 13h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  </span>
                  Campaign list (ACA, FE, HI, dispatch…)
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"></circle>
                      <path d="M12 8v4.5l3 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  Usually same-day reply on WhatsApp
                </li>
              </ul>
              <a class="ct-btn ct-btn--solid ct-reach__cta" href={wa.general} target="_blank" rel="noopener noreferrer">
                Open WhatsApp
              </a>
            </div>

            <div
              class="ct-reach__panel"
              role="tabpanel"
              data-channel-panel="email"
              aria-labelledby="ct-tab-email"
              hidden
            >
              <p class="ct-reach__kicker">For briefs &amp; contracts</p>
              <p class="ct-reach__value">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
              <p class="ct-reach__note">Attachments and longer threads belong on email.</p>
              <ul class="ct-reach__tips">
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
                      <path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  </span>
                  Scope and timeline in the first message
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M14 4H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9l-4-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M14 4v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M9.5 13.5h5M9.5 16.5h3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  </span>
                  Attach scripts or compliance notes if ready
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M4 7.5 12 12l8-4.5V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M4 7.5 12 12l8-4.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  We reply from the same address
                </li>
              </ul>
              <a class="ct-btn ct-btn--solid ct-reach__cta" href={`mailto:${site.email}`}>Send email</a>
            </div>

            <div
              class="ct-reach__panel"
              role="tabpanel"
              data-channel-panel="office"
              aria-labelledby="ct-tab-office"
              hidden
            >
              <p class="ct-reach__kicker">Islamabad HQ</p>
              <p class="ct-reach__value ct-reach__value--addr">
                {site.address.line1}<br />
                {site.address.line2}<br />
                {site.address.city}
              </p>
              <p class="ct-reach__note">Message before you drop by — we will confirm someone is in.</p>
              <ul class="ct-reach__tips">
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M4 14v-1a8 8 0 0 1 16 0v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                      <path d="M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  WhatsApp ahead for a slot
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <path d="M8 5h8v14H8V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M10 9h4M10 13h4M10 17h2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                  </span>
                  Bring dialer notes if you have them
                </li>
                <li>
                  <span class="ct-reach__tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
                      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"></circle>
                      <path d="M12 8v4.5l3 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  Office hours by appointment
                </li>
              </ul>
              <a class="ct-btn ct-btn--solid ct-reach__cta" href={wa.general} target="_blank" rel="noopener noreferrer">
                WhatsApp before visit
              </a>
            </div>
          </div>
        </aside>
      </div>
    </header>

    <section class="ct-section" aria-labelledby="ct-channels-title">
      <div class="ct-shell">
        <div class="ct-section__head" data-reveal>
          <p class="ct-kicker">Channels</p>
          <h2 id="ct-channels-title">Three ways in. One team behind them.</h2>
        </div>
        <ul class="ct-channels">
          {
            channels.map((ch, i) => (
              <li class:list={[{ 'is-primary': ch.primary }]} data-reveal="up" data-lift style={`--reveal-i: ${i}`}>
                <span>{ch.n}</span>
                <h3>{ch.title}</h3>
                <p>{ch.text}</p>
                <a
                  href={ch.href}
                  target={ch.external ? '_blank' : undefined}
                  rel={ch.external ? 'noopener noreferrer' : undefined}
                >
                  {ch.cta}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="ct-section ct-section--brief" aria-labelledby="ct-brief-title">
      <div class="ct-shell">
        <div class="ct-brief-panel" data-reveal>
          <div class="ct-brief-panel__glow" aria-hidden="true"></div>

          <header class="ct-brief-panel__top">
            <div class="ct-brief-panel__intro">
              <p class="ct-kicker">Quick brief</p>
              <h2 id="ct-brief-title">Write it here. We reply by email.</h2>
              <p class="ct-brief__deck">
                Tell us dialer type, campaign, and seats — we place you faster. Prefer chat?
                <a href={wa.general} target="_blank" rel="noopener noreferrer">WhatsApp is open</a>.
              </p>
            </div>
            <div class="ct-brief-panel__signal" aria-label="Typical reply time">
              <span class="ct-brief-panel__pulse" aria-hidden="true"></span>
              <strong>Usually same day</strong>
              <em>Reply to your email</em>
            </div>
          </header>

          <ul class="ct-brief__strip" aria-label="What helps us reply faster">
            <li>
              <span class="ct-brief__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <path d="M4 19V7.5A2.5 2.5 0 0 1 6.5 5H10v14H6.5A2.5 2.5 0 0 1 4 16.5V19Zm10-14h3.5A2.5 2.5 0 0 1 20 7.5V19h-6V5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                  <path d="M10 9h4M10 13h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
              </span>
              <div>
                <strong>Floor fit</strong>
                <span>Dialer + seats</span>
              </div>
            </li>
            <li>
              <span class="ct-brief__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <path d="M5 7.5 12 4l7 3.5v5.2c0 3.7-2.8 6.8-7 7.8-4.2-1-7-4.1-7-7.8V7.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                  <path d="M9.2 12.1 11 14l3.8-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <div>
                <strong>Campaign</strong>
                <span>ACA · FE · HI · dispatch</span>
              </div>
            </li>
            <li>
              <span class="ct-brief__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                  <path d="M7 20V10.5A2.5 2.5 0 0 1 9.5 8H14v12H9.5A2.5 2.5 0 0 1 7 17.5V20Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                  <path d="M14 8h2.5A2.5 2.5 0 0 1 19 10.5V20h-5V8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                  <path d="M10 4.5h4v3.5h-4V4.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
                </svg>
              </span>
              <div>
                <strong>Enterprise</strong>
                <span>Multi-bot · compliance</span>
              </div>
            </li>
          </ul>

          <form id="contact-form" class="ct-form" novalidate data-reveal="up" style="--reveal-i:1">
            <div class="ct-form__body">
              <div class="ct-form__row">
                <label>
                  <span>Name</span>
                  <input name="name" type="text" required autocomplete="name" placeholder="Your name" />
                </label>
                <label>
                  <span>Email</span>
                  <input name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
                </label>
              </div>

              <label>
                <span>Company / floor</span>
                <input name="company" type="text" autocomplete="organization" placeholder="Optional" />
              </label>

              <fieldset class="ct-reasons">
                <legend>Reason</legend>
                <div class="ct-reasons__grid" role="radiogroup" aria-label="Contact reason">
                  {
                    reasons.map((r, i) => (
                      <label class:list={['ct-reason', { 'is-on': i === 0 }]}>
                        <input type="radio" name="reason" value={r} checked={i === 0} />
                        <span>{r}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>

              <label class="ct-form__message">
                <span>Message</span>
                <textarea
                  name="message"
                  rows="5"
                  required
                  placeholder="Dialer type, campaign, seats, what you need…"></textarea>
              </label>

              <label class="ct-form__hp" aria-hidden="true">
                <span>Website</span>
                <input name="website" type="text" tabindex="-1" autocomplete="off" />
              </label>

              <p class="ct-form__status" data-form-status role="status" aria-live="polite" hidden></p>
              <a
                class="ct-form__wa"
                data-form-wa
                href={wa.afterContact}
                target="_blank"
                rel="noopener noreferrer"
                hidden
              >
                Continue on WhatsApp
              </a>
            </div>

            <div class="ct-form__foot">
              <button class="ct-btn ct-btn--solid ct-form__submit" type="submit" data-form-submit>
                Send brief
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <p class="ct-form__note">
                No account needed.
                <a href={wa.general} target="_blank" rel="noopener noreferrer">Prefer WhatsApp?</a>
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function initReach(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-channel-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-channel-panel]'));

    const setChannel = (channel: string) => {
      root.dataset.channel = channel;
      tabs.forEach((tab) => {
        const on = tab.dataset.channelTab === channel;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => {
        const on = panel.dataset.channelPanel === channel;
        panel.classList.toggle('is-active', on);
        panel.hidden = !on;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setChannel(tab.dataset.channelTab || 'whatsapp'));
    });

    root.querySelector('.ct-reach__tabs')?.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      const current = tabs.findIndex((t) => t.classList.contains('is-active'));
      if (current < 0) return;
      let next = current;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (current + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (current - 1 + tabs.length) % tabs.length;
      else return;
      e.preventDefault();
      tabs[next].focus();
      setChannel(tabs[next].dataset.channelTab || 'whatsapp');
    });

    setChannel(root.dataset.channel || 'whatsapp');
  }

  document.querySelectorAll<HTMLElement>('[data-ct-reach]').forEach(initReach);

  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.querySelectorAll<HTMLLabelElement>('.ct-reason').forEach((label) => {
    const input = label.querySelector<HTMLInputElement>('input');
    input?.addEventListener('change', () => {
      form.querySelectorAll('.ct-reason').forEach((el) => el.classList.remove('is-on'));
      if (input.checked) label.classList.add('is-on');
    });
  });

  const statusEl = form?.querySelector<HTMLElement>('[data-form-status]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-form-submit]');
  const waAfter = form?.querySelector<HTMLAnchorElement>('[data-form-wa]');

  const setStatus = (text: string, kind: 'ok' | 'err' | '') => {
    if (!statusEl) return;
    statusEl.hidden = !text;
    statusEl.textContent = text;
    statusEl.dataset.kind = kind;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = {
      name: String(fd.get('name') || '').trim(),
      email: String(fd.get('email') || '').trim(),
      company: String(fd.get('company') || '').trim(),
      reason: String(fd.get('reason') || '').trim(),
      message: String(fd.get('message') || '').trim(),
      website: String(fd.get('website') || '').trim(),
    };

    if (!payload.name || !payload.email || !payload.message) {
      setStatus('Name, email, and message are required.', 'err');
      if (waAfter) waAfter.hidden = true;
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }
    setStatus('', '');
    if (waAfter) waAfter.hidden = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

      if (!res.ok || !data.ok) {
        setStatus(data.error || 'Could not send. Try again or WhatsApp us.', 'err');
        return;
      }

      form.reset();
      form.querySelectorAll('.ct-reason').forEach((el, i) => el.classList.toggle('is-on', i === 0));
      const firstReason = form.querySelector<HTMLInputElement>('input[name="reason"]');
      if (firstReason) firstReason.checked = true;
      setStatus('Sent. We will reply by email — continue on WhatsApp for a faster start.', 'ok');
      if (waAfter) waAfter.hidden = false;
    } catch {
      setStatus('Network error. Check your connection or WhatsApp us.', 'err');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send brief';
      }
    }
  });
</script>
