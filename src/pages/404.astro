---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa } from '../data/site';
import '../styles/global.css';
import '../styles/not-found-page.css';
---

<BaseLayout title="Page Not Found | Dialer Bot" description="That Dialer Bot page may have moved or no longer exists.">
  <Header slot="header" />

  <main class="nf page-mast" data-mast>
    <PageMastFx />
    <div class="nf-shell">
      <p class="nf-brand">Dialer Bot</p>
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>This page is off the dialer</h1>
      <p class="nf-deck">
        That URL may have moved, or it never existed. Jump back to a live floor page — or WhatsApp us if something
        broke.
      </p>
      <div class="nf-actions">
        <a class="nf-btn nf-btn--solid" href="/">Go home</a>
        <a class="nf-btn nf-btn--ghost" href="/features">Features</a>
        <a class="nf-btn nf-btn--ghost" href="/contact">Contact</a>
        <a class="nf-btn nf-btn--lime" href={wa.general} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </div>
      <ul class="nf-links">
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/blog">Insights</a></li>
        <li><a href="/faqs">FAQs</a></li>
        <li><a href="/careers">Careers</a></li>
      </ul>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
