---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Page Not Found">
  <Header slot="header" />
  <section class="section">
    <div class="container" style="text-align:center;padding:4rem 1rem">
      <h1 style="font-size:4rem;color:var(--accent-1);line-height:1">404</h1>
      <h2 style="margin:0.5rem 0 1rem">Page not found</h2>
      <p style="color:var(--accent-3);margin-bottom:1.5rem">That page may have moved or no longer exists.</p>
      <a class="btn btn-dark" href="/">Go Home</a>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
