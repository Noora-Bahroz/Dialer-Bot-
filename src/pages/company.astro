---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/company-page.css';

export const prerender = true;

const beliefs = [
  {
    n: '01',
    title: 'AI should help your team, not replace it',
    text: 'Human agents are still needed for tough conversations, empathy, and closing the final deal.',
  },
  {
    n: '02',
    title: 'Results should be easy to see',
    text: 'You should always know exactly how a campaign is doing and what needs to improve.',
  },
  {
    n: '03',
    title: 'Keep your current tools',
    text: 'A great AI system shouldn\'t force you to throw away the software you already use and like.',
  },
  {
    n: '04',
    title: 'Simple is better',
    text: 'Your team should always know what the bot is doing and why a call was transferred.',
  },
  {
    n: '05',
    title: "Don't automate just to look cool",
    text: "The goal isn't to use more AI. The goal is to make your business run better and make more money.",
  },
];

const careAbout = [
  'Call Length',
  'Lead Quality',
  'Smooth Transfers',
  'Agent Happiness',
  'Campaign Results',
  'Call Quality',
  'Reliability',
];
---

<BaseLayout
  title="Company | DialerBot"
  description="We build AI for the people who spend their day on the phone. Dialer Bot helps call centers qualify calls automatically and live-transfer qualified leads to human closers."
  image="/images/dialerbot-company-05.webp"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Company', path: '/company' },
  ])}
>
  <Header slot="header" />

  <div class="co">
    <header class="co-mast page-mast" data-mast>
      <PageMastFx />
      <div class="co-shell co-mast__grid">
        <div class="co-mast__copy">
          <nav class="co-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Company</span>
          </nav>
          <p class="co-brand">About Dialer Bot</p>
          <h1>We build AI for teams that spend their day on the phone.</h1>
          <p class="co-deck">
            Dialer Bot is an AI voice bot for call-center operations. It works with your existing PC dialer, handles the first part of every call, and live-transfers qualified leads to a human closer who completes the sale.
          </p>
          <p class="co-deck" style="margin-top:0.75rem">
            We don't want to replace everyone. We just want to handle the repetitive work so your people can focus on closing deals.
          </p>
          <div class="co-actions">
            <a class="co-btn co-btn--solid" href={demo.company} target="_blank" rel="noopener noreferrer">
              Try the Live Demo
            </a>
            <a class="co-btn co-btn--ghost" href={wa.general} target="_blank" rel="noopener noreferrer">
              Talk to the Team
            </a>
          </div>
        </div>

        <aside class="co-mast__aside" aria-label="Headquarters">
          <div class="co-hq">
            <div class="co-hq__top">
              <p class="co-hq__label">Headquarters</p>
              <span class="co-hq__badge">Islamabad</span>
            </div>
            <address class="co-hq__address">
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.city}, Pakistan
            </address>
            <dl class="co-hq__grid">
              <div>
                <dt>WhatsApp</dt>
                <dd>
                  <a href={wa.general} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
                </dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
              </div>
              <div>
                <dt>Web</dt>
                <dd>{site.domain}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="co-section" aria-labelledby="co-mission-title">
      <div class="co-shell co-story">
        <div class="co-story__copy" data-reveal="left">
          <p class="co-kicker">Our Mission</p>
          <h2 id="co-mission-title">Make every conversation count.</h2>
          <p>
            Call centers make thousands of calls every day. Most of them start exactly the same way â€” the same hello, the same basic questions, the same quick hang-ups.
          </p>
          <p>
            Dialer Bot handles this repetitive early step using AI, so your human closers only step in when it's time to actually help the customer and close the deal.
          </p>
        </div>
        <figure class="co-story__media" data-reveal="right" style="--reveal-i:1">
          <img
            src="/images/dialerbot-company-05.webp"
            alt="Dialer Bot office in Islamabad"
            width="640"
            height="520"
          />
          <figcaption>
            <strong>Office 12</strong>
            <span>Pakistan Town Phase 2 Â· Islamabad</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="co-section co-section--tint" aria-labelledby="co-story-title">
      <div class="co-shell">
        <div class="co-section__head" data-reveal>
          <p class="co-kicker">Our story</p>
          <h2 id="co-story-title">Built from the call-center workflow up.</h2>
        </div>
        <div class="co-story__copy" data-reveal style="max-width:48rem;margin-inline:auto">
          <p>
            Dialer Bot started with a simple truth: phone agents spend way too much time talking to people who will never buy anything.
          </p>
          <p>
            There are many AI tools out there, but most of them are made for simple customer service, not for fast-paced calling teams.
          </p>
          <p>
            So we built Dialer Bot to fit right into what you already do:
            <strong> Dial â†’ AI chats first â†’ Finds good leads â†’ Transfers to a human â†’ Deal closed.</strong>
          </p>
          <p>
            The result is an AI that helps your team without forcing you to change everything about how you work.
          </p>
        </div>
      </div>
    </section>

    <section class="co-section" aria-labelledby="co-beliefs-title">
      <div class="co-shell">
        <div class="co-section__head" data-reveal>
          <p class="co-kicker">Our Core Beliefs</p>
          <h2 id="co-beliefs-title">Rules we live by</h2>
        </div>
        <ul class="co-principles">
          {
            beliefs.map((item, i) => (
              <li data-reveal="up" data-lift style={`--reveal-i: ${i % 3}`}>
                <span>{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="co-section co-section--tint" aria-labelledby="co-diff-title">
      <div class="co-shell">
        <div class="co-section__head" data-reveal>
          <p class="co-kicker">Why we are different</p>
          <h2 id="co-diff-title">We think like phone agents.</h2>
          <p style="max-width:40rem;margin:0.75rem auto 0;opacity:0.85">
            A fancy AI is useless if it breaks during a real campaign. We built our tool to survive the real world.
          </p>
        </div>
        <ol class="co-arc">
          {
            careAbout.map((item, i) => (
              <li data-reveal="up" style={`--reveal-i: ${i % 4}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{item}</h3>
                <p>We care about this because your team does.</p>
              </li>
            ))
          }
        </ol>
        <div class="co-actions" style="justify-content:center;margin-top:2.5rem" data-reveal>
          <a class="co-btn co-btn--solid" href={demo.company} target="_blank" rel="noopener noreferrer">
            Try the Live Demo
          </a>
          <a class="co-btn co-btn--ghost" href={wa.general} target="_blank" rel="noopener noreferrer">
            Talk to Dialer Bot
          </a>
        </div>
        <p style="text-align:center;margin-top:1.25rem;max-width:36rem;margin-inline:auto;opacity:0.8" data-reveal>
          Have a calling problem? Tell us about it. We'll help you figure out if AI can actually fix it.
        </p>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
