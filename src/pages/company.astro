---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { wa, site } from '../data/site';
import '../styles/global.css';
import '../styles/company-page.css';

const arc = [
  {
    n: '01',
    title: 'The problem',
    text: 'Floors burned seats on openers and tire-kickers while closers waited for conversations worth having.',
  },
  {
    n: '02',
    title: 'The build',
    text: 'Humanized voices, locked first questions, adaptive follow-ups, and warm handoffs into dialers teams already run.',
  },
  {
    n: '03',
    title: 'Today',
    text: 'Inbound and outbound teams across insurance, dispatch, and sales — supported from ZamZama Plaza.',
  },
];

const principles = [
  {
    n: '01',
    title: 'Floor-first',
    text: 'If it does not survive a live campaign morning, it does not ship.',
  },
  {
    n: '02',
    title: 'Honest qualification',
    text: 'Filter noise. Never invent interest. Optimize for cleaner handoffs.',
  },
  {
    n: '03',
    title: 'Close enough to care',
    text: 'WhatsApp reaches the builders in Rawalpindi — not a ticket queue abroad.',
  },
];
---

<BaseLayout
  title="Company | Dialer Bot"
  description="About Dialer Bot — AI voice bots from Office 8, ZamZama Plaza, Pakistan Town Phase 2, Rawalpindi."
>
  <Header slot="header" />

  <main class="co">
    <header class="co-mast">
      <div class="co-shell co-mast__grid">
        <div class="co-mast__copy">
          <nav class="co-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Company</span>
          </nav>
          <p class="co-brand">Dialer Bot</p>
          <h1>Built beside the dialers, not above them</h1>
          <p class="co-deck">
            We protect agent time — greet, ask, confirm, then warm a seat. From Office 8 in Rawalpindi, on
            WhatsApp whenever the floor needs us.
          </p>
          <div class="co-actions">
            <a class="co-btn co-btn--solid" href={wa.general} target="_blank" rel="noopener noreferrer">
              WhatsApp the team
            </a>
            <a class="co-btn co-btn--ghost" href="/careers">See careers</a>
          </div>
        </div>

        <aside class="co-mast__aside" aria-label="Headquarters">
          <div class="co-hq">
            <p class="co-hq__label">Headquarters</p>
            <address>
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.city}
            </address>
            <dl>
              <div>
                <dt>WhatsApp</dt>
                <dd>
                  <a href={wa.general} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
                </dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
              </div>
              <div>
                <dt>Web</dt>
                <dd>{site.domain}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="co-section" aria-labelledby="co-story-title">
      <div class="co-shell co-story">
        <div class="co-story__copy">
          <p class="co-kicker">Our story</p>
          <h2 id="co-story-title">From noisy floors to cleaner handoffs</h2>
          <p>
            Dialer Bot was shaped beside real calling teams — ACA and final expense books, health insurance
            blitzes, truck dispatch desks, and inbound lines that rang whether anyone was ready.
          </p>
          <p>
            The pattern was always the same: talent stuck on intake, closers underused, supervisors juggling pace
            with too few hands. We did not set out to replace agents. We set out to protect their time.
          </p>
          <p>
            That idea — simple on a slide, hard on a live dialer — is still the center of every release we ship
            from Rawalpindi.
          </p>
        </div>
        <figure class="co-story__media">
          <img src="/images/dialerbot-company-05.webp" alt="" width="640" height="520" />
          <figcaption>
            <strong>Office 8</strong>
            <span>ZamZama Plaza · Rawalpindi</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="co-section co-section--tint" aria-labelledby="co-arc-title">
      <div class="co-shell">
        <div class="co-section__head">
          <p class="co-kicker">How we got here</p>
          <h2 id="co-arc-title">A short arc. A long floor day.</h2>
        </div>
        <ol class="co-arc">
          {
            arc.map((item) => (
              <li>
                <span>{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="co-section" aria-labelledby="co-principles-title">
      <div class="co-shell">
        <div class="co-section__head">
          <p class="co-kicker">Operating principles</p>
          <h2 id="co-principles-title">Three commitments on every bot</h2>
        </div>
        <ul class="co-principles">
          {
            principles.map((item) => (
              <li>
                <span>{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="co-close">
      <div class="co-shell co-close__inner">
        <div>
          <p class="co-brand co-brand--on-dark">Dialer Bot</p>
          <h2>Come by ZamZama Plaza — or just WhatsApp</h2>
          <p>Office 8 is open for serious floors. Remote teams get the same direct line.</p>
        </div>
        <a class="co-btn co-btn--lime" href={wa.general} target="_blank" rel="noopener noreferrer">
          Chat on WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
