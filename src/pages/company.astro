---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Company" description="About Cryzel — building secure, seamless financial and campaign tools.">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1>Company</h1>
      <p>We help teams capture attention and convert it into lasting growth.</p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Company</span>
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:3rem;align-items:center">
      <div>
        <p class="section-label" style="text-align:left">Our mission</p>
        <h2 style="font-size:clamp(1.75rem,3vw,2.5rem);letter-spacing:-0.02em;margin-bottom:1rem">
          Simplicity and adaptability for modern businesses
        </h2>
        <p style="color:var(--accent-3);margin-bottom:1rem">
          Cryzel emphasizes flexible design and practical tooling for personal brands, portfolios,
          magazines, and growth-focused companies. This static frontend preserves the Cryzel look —
          deep greens, lime accents, and Manrope typography — without WordPress.
        </p>
        <p style="color:var(--accent-3);margin-bottom:1.5rem">
          From secure financial workflows to result-driven campaigns, we build experiences that feel
          calm, clear, and ready to ship.
        </p>
        <a class="btn btn-dark" href="/contact">Work with us</a>
      </div>
      <img
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&q=80"
        alt="Cryzel team collaborating"
        width="640"
        height="480"
        style="border-radius:var(--radius);width:100%;height:420px;object-fit:cover"
      />
    </div>
  </section>

  <section class="section" id="careers" style="background:var(--accent-6)">
    <div class="container">
      <p class="section-label">Careers</p>
      <h2 class="section-title">Join the Cryzel team</h2>
      <div class="cards-3">
        <article class="card">
          <h3>Product Designer</h3>
          <p>Shape calm, high-clarity interfaces for marketers and finance teams.</p>
        </article>
        <article class="card">
          <h3>Full-Stack Engineer</h3>
          <p>Build reliable APIs and delightful product surfaces at scale.</p>
        </article>
        <article class="card">
          <h3>Customer Success</h3>
          <p>Help customers launch funnels and grow with confidence.</p>
        </article>
      </div>
      <p style="text-align:center;margin-top:2rem">
        <a class="btn btn-dark" href="/contact">View openings</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .container[style*='grid-template-columns'] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
