---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMastFx from '../components/PageMastFx.astro';
import { wa, site, demo } from '../data/site';
import { breadcrumbJsonLd } from '../data/seo';
import '../styles/global.css';
import '../styles/company-page.css';

export const prerender = true;

const arc = [
  {
    n: '01',
    title: 'The problem',
    text: 'Floors burned seats on openers and tire-kickers while closers waited for conversations worth having.',
  },
  {
    n: '02',
    title: 'The build',
    text: 'Humanized voices, locked first questions, adaptive follow-ups, and warm handoffs into dialers teams already run.',
  },
  {
    n: '03',
    title: 'Today',
    text: 'Inbound and outbound teams across insurance, dispatch, and sales — supported from Islamabad.',
  },
];

const principles = [
  {
    n: '01',
    title: 'Floor-first',
    text: 'If it does not survive a live campaign morning, it does not ship.',
  },
  {
    n: '02',
    title: 'Honest qualification',
    text: 'Filter noise. Never invent interest. Optimize for cleaner handoffs.',
  },
  {
    n: '03',
    title: 'Close enough to care',
    text: 'WhatsApp reaches the builders in Islamabad — not a ticket queue abroad.',
  },
];
---

<BaseLayout
  title="Company | Dialer Bot"
  description="About Dialer Bot — AI voice qualification built in Islamabad for dialers, truck dispatch, and insurance calling floors."
  image="/images/dialerbot-company-05.webp"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Company', path: '/company' },
  ])}
>
  <Header slot="header" />

  <div class="co">
    <header class="co-mast page-mast" data-mast>
      <PageMastFx />
      <div class="co-shell co-mast__grid">
        <div class="co-mast__copy">
          <nav class="co-crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Company</span>
          </nav>
          <p class="co-brand">Dialer Bot</p>
          <h1>Built beside the dialers, not above them</h1>
          <p class="co-deck">
            We protect agent time — greet, ask, confirm, then warm a seat. From Office 12 in Islamabad, on
            WhatsApp whenever the floor needs us.
          </p>
          <div class="co-actions">
            <a class="co-btn co-btn--solid" href={demo.company} target="_blank" rel="noopener noreferrer">
              Try live demo
            </a>
            <a class="co-btn co-btn--ghost" href={wa.general} target="_blank" rel="noopener noreferrer">WhatsApp the team</a>
          </div>
        </div>

        <aside class="co-mast__aside" aria-label="Headquarters">
          <div class="co-hq">
            <div class="co-hq__top">
              <p class="co-hq__label">Headquarters</p>
              <span class="co-hq__badge">Islamabad</span>
            </div>
            <address class="co-hq__address">
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.city}
            </address>
            <dl class="co-hq__grid">
              <div>
                <dt>WhatsApp</dt>
                <dd>
                  <a href={wa.general} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
                </dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
              </div>
              <div>
                <dt>Web</dt>
                <dd>{site.domain}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </header>

    <section class="co-section" aria-labelledby="co-story-title">
      <div class="co-shell co-story">
        <div class="co-story__copy" data-reveal="left">
          <p class="co-kicker">Our story</p>
          <h2 id="co-story-title">From noisy floors to cleaner handoffs</h2>
          <p>
            Dialer Bot was shaped beside real calling teams — ACA and final expense books, health insurance
            blitzes, truck dispatch desks, and inbound lines that rang whether anyone was ready.
          </p>
          <p>
            The pattern was always the same: talent stuck on intake, closers underused, supervisors juggling pace
            with too few hands. We did not set out to replace agents. We set out to protect their time.
          </p>
          <p>
            That idea — simple on a slide, hard on a live dialer — is still the center of every release we ship
            from Islamabad.
          </p>
        </div>
        <figure class="co-story__media" data-reveal="right" style="--reveal-i:1">
          <img
            src="/images/dialerbot-company-05.webp"
            alt="Dialer Bot office at Office 12, Pakistan Town Phase 2, Islamabad"
            width="640"
            height="520"
          />
          <figcaption>
            <strong>Office 12</strong>
            <span>Pakistan Town Phase 2 · Islamabad</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="co-section co-section--tint" aria-labelledby="co-arc-title">
      <div class="co-shell">
        <div class="co-section__head" data-reveal>
          <p class="co-kicker">How we got here</p>
          <h2 id="co-arc-title">A short arc. A long floor day.</h2>
        </div>
        <ol class="co-arc">
          {
            arc.map((item, i) => (
              <li data-reveal="up" style={`--reveal-i: ${i}`}>
                <span>{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="co-section" aria-labelledby="co-principles-title">
      <div class="co-shell">
        <div class="co-section__head" data-reveal>
          <p class="co-kicker">Operating principles</p>
          <h2 id="co-principles-title">Three commitments on every bot</h2>
        </div>
        <ul class="co-principles">
          {
            principles.map((item, i) => (
              <li data-reveal="up" data-lift style={`--reveal-i: ${i}`}>
                <span>{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</BaseLayout>
